@model IList<RoleListItem>
@{
    ViewData["Title"] = "Roles";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Roles</h2>
    <a class="btn btn-primary" asp-action="Create">+ New Role</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Permissions</th>
            <th>Type</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var r in Model)
    {
        <tr>
            <td>@r.Name</td>
            <td>@r.PermissionCount</td>
            <td>
                @if (r.IsSystemRole)
                {
                    <span class="badge bg-warning text-dark">System</span>
                }
                else
                {
                    <span class="badge bg-secondary">Custom</span>
                }
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Permissions" asp-route-id="@r.Id">Permissions</a>
                @if (!r.IsSystemRole)
                {
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@r.Id">Edit</a>
                    <form method="post" asp-action="Delete" asp-route-id="@r.Id" class="d-inline"
                          onsubmit="return confirm('Delete this role?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                    </form>
                }
            </td>
        </tr>
    }
    </tbody>
</table>
