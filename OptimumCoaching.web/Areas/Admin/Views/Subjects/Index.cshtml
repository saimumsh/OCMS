@model IList<SubjectListItem>
@{
    ViewData["Title"] = "Subjects";
    var activeDepartmentId = ViewBag.ActiveDepartmentId as Guid?;
    var departmentOptions = (ViewBag.DepartmentOptions as IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)
                            ?? Enumerable.Empty<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>();

    // Group rows by department so the list stays scannable when many subjects exist.
    var groups = Model
        .GroupBy(s => new { s.DepartmentId, s.DepartmentName, s.DepartmentStream })
        .OrderBy(g => g.Key.DepartmentStream).ThenBy(g => g.Key.DepartmentName)
        .ToList();
}

<div class="content-header row">
    <div class="content-header-left col-md-7 col-12 mb-1">
        <h3 class="content-header-title mb-0">Subjects</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Configuration</li>
                    <li class="breadcrumb-item active">Subjects</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-5 col-12 mb-1 text-md-right">
        <form method="get" class="form-inline justify-content-md-end mb-1 d-inline-block">
            <label class="mr-1 mb-0 small text-muted">Department:</label>
            <select name="departmentId" class="form-control form-control-sm mr-1"
                    onchange="this.form.submit()">
                <option value="">All</option>
                @foreach (var opt in departmentOptions)
                {
                    if (Guid.TryParse(opt.Value, out var g) && activeDepartmentId == g)
                    {
                        <option value="@opt.Value" selected>@opt.Text</option>
                    }
                    else
                    {
                        <option value="@opt.Value">@opt.Text</option>
                    }
                }
            </select>
            <a class="btn btn-sm btn-custom" asp-action="Create" asp-route-departmentId="@activeDepartmentId">
                <i class="fa fa-plus"></i> Add Subject
            </a>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-3"><p class="text-muted mb-0">No subjects configured.</p></div>
    </div>
}
else
{
    foreach (var grp in groups)
    {
        var deptLabel = string.IsNullOrEmpty(grp.Key.DepartmentName) ? "Unassigned" : grp.Key.DepartmentName;
        var streamLabel = grp.Key.DepartmentStream == EducationStream.Diploma ? "Diploma"
                       : grp.Key.DepartmentStream == EducationStream.Academic ? "Academic"
                       : null;

        <div class="card mb-2">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="card-title mb-0">
                        @deptLabel
                        @if (streamLabel != null)
                        { <span class="badge badge-light text-muted ml-1">@streamLabel</span> }
                        <span class="badge badge-pill badge-secondary ml-1">@grp.Count()</span>
                    </h4>
                </div>
                @if (grp.Key.DepartmentId.HasValue)
                {
                    <a class="btn btn-sm btn-custom" asp-action="Create" asp-route-departmentId="@grp.Key.DepartmentId">
                        <i class="fa fa-plus"></i> Add to @deptLabel
                    </a>
                }
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-condensed mb-0 user-table">
                        <thead>
                            <tr>
                                <th class="serial">#</th>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Class</th>
                                <th>Description</th>
                                <th class="text-center">Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 0; }
                            @foreach (var s in grp)
                            {
                                sn++;
                                <tr>
                                    <td class="align-middle">@sn</td>
                                    <td class="align-middle"><strong>@s.Name</strong></td>
                                    <td class="align-middle"><span class="badge badge-light">@(s.Code ?? "—")</span></td>
                                    <td class="align-middle">@(s.ClassName ?? "—")</td>
                                    <td class="align-middle">@(s.Description ?? "—")</td>
                                    <td class="align-middle text-center">
                                        @if (s.IsActive)
                                        { <span class="badge badge-pill badge-success">Active</span> }
                                        else
                                        { <span class="badge badge-pill badge-secondary">Inactive</span> }
                                    </td>
                                    <td class="align-middle text-right action-cell">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline"
                                              onsubmit="return confirm('Remove @s.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
