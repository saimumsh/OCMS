@model IList<OptimumCoaching.core.Assignment>
@using Microsoft.AspNetCore.Mvc.Rendering
@using OptimumCoaching.core
@{
    ViewData["Title"] = "Assignments";
    var batchOptions = (IList<SelectListItem>)ViewBag.BatchOptions;
    var topicOptions = ViewBag.TopicOptions as IList<SelectListItem> ?? new List<SelectListItem>();
    var activeBatchId = ViewBag.ActiveBatchId as Guid?;
    var batch = ViewBag.Batch as Batch;
    var canManage = User.Identity != null && User.Identity.HasPermission(Permissions.Assignments.Manage);
    var canGrade  = User.Identity != null && User.Identity.HasPermission(Permissions.Assignments.Grade);
}

<div class="content-header row">
    <div class="content-header-left col-md-7 col-12 mb-1">
        <h3 class="content-header-title mb-0"><i class="fa fa-tasks mr-1 text-info"></i> Assignments</h3>
        @if (batch != null) { <small class="text-muted">@batch.Name</small> }
    </div>
    <div class="content-header-right col-md-5 col-12 mb-1 text-md-right">
        <form method="get" class="form-inline justify-content-md-end mb-1 d-inline-block">
            <select name="batchId" class="form-control form-control-sm" onchange="this.form.submit()">
                <option value="">— Choose batch —</option>
                @foreach (var o in batchOptions)
                {
                    if (Guid.TryParse(o.Value, out var g) && activeBatchId == g)
                    { <option value="@o.Value" selected>@o.Text</option> }
                    else
                    { <option value="@o.Value">@o.Text</option> }
                }
            </select>
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"]   != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

@if (!activeBatchId.HasValue)
{
    <div class="card"><div class="card-body text-center py-3"><p class="text-muted mb-0">Pick a batch to manage assignments.</p></div></div>
    return;
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                <h4 class="card-title mb-0">Assignments <span class="badge badge-pill badge-secondary ml-1">@Model.Count</span></h4>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                { <p class="text-muted text-center py-3 mb-0">No assignments yet.</p> }
                else
                {
                    <table class="table table-condensed mb-0 user-table">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Topic</th>
                                <th>Due</th>
                                <th>Max</th>
                                <th class="text-center">Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in Model)
                            {
                                <tr>
                                    <td class="align-middle"><strong>@a.Title</strong></td>
                                    <td class="align-middle">@(a.Topic?.Title ?? "—")</td>
                                    <td class="align-middle">@(a.DueDate?.ToString("dd MMM yyyy") ?? "—")</td>
                                    <td class="align-middle">@a.MaxScore</td>
                                    <td class="align-middle text-center">
                                        @switch (a.Status)
                                        {
                                            case AssignmentStatus.Published: <span class="badge badge-pill badge-success">Published</span> break;
                                            case AssignmentStatus.Closed: <span class="badge badge-pill badge-secondary">Closed</span> break;
                                            default: <span class="badge badge-pill badge-warning">Draft</span> break;
                                        }
                                    </td>
                                    <td class="align-middle text-right">
                                        @if (canGrade)
                                        {
                                            <a class="btn btn-sm btn-outline-info" asp-action="Submissions" asp-route-id="@a.Id" title="Grade">
                                                <i class="fa fa-pencil"></i>
                                            </a>
                                        }
                                        @if (canManage)
                                        {
                                            <form method="post" asp-action="Publish" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@a.Id" />
                                                <input type="hidden" name="batchId" value="@activeBatchId" />
                                                <input type="hidden" name="publish" value="@((a.Status != AssignmentStatus.Published).ToString().ToLower())" />
                                                <button type="submit" class="btn btn-sm @(a.Status == AssignmentStatus.Published ? "btn-outline-secondary" : "btn-outline-success")">
                                                    <i class="fa @(a.Status == AssignmentStatus.Published ? "fa-eye-slash" : "fa-bullhorn")"></i>
                                                </button>
                                            </form>
                                            <form method="post" asp-action="Delete" class="d-inline" onsubmit="return confirm('Remove this assignment?');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@a.Id" />
                                                <input type="hidden" name="batchId" value="@activeBatchId" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger"><i class="fa fa-trash"></i></button>
                                            </form>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        </div>
    </div>

    @if (canManage)
    {
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                    <h4 class="card-title mb-0">New assignment</h4>
                </div>
                <form method="post" asp-action="Create" enctype="multipart/form-data">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="BatchId" value="@activeBatchId" />
                    <div class="card-body">
                        <div class="form-group"><label>Title</label><input name="Title" class="form-control" required /></div>
                        <div class="form-group">
                            <label>Topic <span class="text-muted">(optional)</span></label>
                            <select name="TopicId" class="form-control">
                                <option value="">—</option>
                                @foreach (var o in topicOptions) { <option value="@o.Value">@o.Text</option> }
                            </select>
                        </div>
                        <div class="form-row">
                            <div class="form-group col-6"><label>Due date</label><input type="date" name="DueDate" class="form-control" /></div>
                            <div class="form-group col-6"><label>Max score</label><input type="number" step="0.01" name="MaxScore" value="100" class="form-control" required /></div>
                        </div>
                        <div class="form-group"><label>Instructions</label><textarea name="Instructions" class="form-control" rows="4" required></textarea></div>
                        <div class="form-group"><label>Attachment (question paper)</label><input type="file" name="attachment" class="form-control-file" /></div>
                    </div>
                    <div class="card-footer text-right">
                        <button type="submit" class="btn btn-custom"><i class="fa fa-plus"></i> Create draft</button>
                    </div>
                </form>
            </div>
        </div>
    }
</div>
