@model IList<OptimumCoaching.core.AssignmentSubmission>
@using OptimumCoaching.core
@{
    var a = (Assignment)ViewBag.Assignment;
    ViewData["Title"] = $"Submissions — {a.Title}";
}

<div class="content-header row">
    <div class="content-header-left col-12 mb-1">
        <h3 class="content-header-title mb-0">@a.Title <small class="text-muted">· Max @a.MaxScore</small></h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index" asp-route-batchId="@a.BatchId">Assignments</a></li>
                    <li class="breadcrumb-item active">Submissions</li>
                </ol>
            </div>
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"]   != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center py-3"><p class="text-muted mb-0">No submissions yet.</p></div></div>
    return;
}

@foreach (var s in Model)
{
    var formId = $"grade-{s.Id}";
    <div class="card mb-2">
        <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
            <div>
                <strong>@s.Student.FullName</strong>
                @if (!string.IsNullOrWhiteSpace(s.Student.StudentCode))
                { <span class="badge badge-light ml-1">@s.Student.StudentCode</span> }
                <small class="text-muted ml-2">Submitted @s.SubmittedAt.ToString("dd MMM yyyy, HH:mm")</small>
            </div>
            @if (s.Status == SubmissionStatus.Graded)
            { <span class="badge badge-pill badge-success">Graded: @s.Score?.ToString("0.##") / @a.MaxScore</span> }
            else
            { <span class="badge badge-pill badge-warning">Awaiting grade</span> }
        </div>
        <div class="card-body">
            @if (!string.IsNullOrWhiteSpace(s.ResponseText))
            { <div style="white-space:pre-wrap">@s.ResponseText</div> }
            @if (!string.IsNullOrWhiteSpace(s.FilePath))
            {
                <div class="mt-1">
                    <a href="@Url.Content(s.FilePath)" target="_blank" class="btn btn-sm btn-outline-primary">
                        <i class="fa fa-download mr-1"></i> Submission file
                    </a>
                </div>
            }
        </div>
        <div class="card-footer">
            <form method="post" asp-action="Grade" asp-route-id="@s.Id" class="form-inline align-items-end">
                @Html.AntiForgeryToken()
                <input type="hidden" name="assignmentId" value="@a.Id" />
                <div class="form-group mr-1 mb-1">
                    <label class="d-block small">Score (max @a.MaxScore)</label>
                    <input name="score" type="number" step="0.01" min="0" max="@a.MaxScore" value="@s.Score" class="form-control form-control-sm" style="width:120px" />
                </div>
                <div class="form-group mr-1 mb-1 flex-grow-1">
                    <label class="d-block small">Feedback</label>
                    <input name="feedback" value="@s.Feedback" class="form-control form-control-sm" />
                </div>
                <button type="submit" class="btn btn-custom btn-sm mb-1"><i class="fa fa-check mr-1"></i> Save</button>
            </form>
        </div>
    </div>
}
