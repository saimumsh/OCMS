@model BatchFormViewModel

<input asp-for="Id" type="hidden" />

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                <h4 class="card-title mb-0">@(Model.Id == Guid.Empty ? "New Batch" : "Edit Batch")</h4>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-1"></div>

                <div class="form-group row">
                    <label asp-for="DepartmentId" class="col-sm-3 col-form-label label-control required">Department</label>
                    <div class="col-sm-9">
                        <select asp-for="DepartmentId" asp-items="Model.DepartmentOptions" class="form-control">
                            <option value="">— Select —</option>
                        </select>
                        <span asp-validation-for="DepartmentId" class="text-danger"></span>
                        <small class="text-muted">Department-wise filter applies to Class &amp; Subject lists.</small>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Name" class="col-sm-3 col-form-label label-control required"></label>
                    <div class="col-sm-9">
                        <input asp-for="Name" class="form-control" placeholder="e.g. Diploma 4th Sem  Batch A" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Code" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="Code" class="form-control" placeholder="Optional short code" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="ClassId" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <select asp-for="ClassId" asp-items="Model.ClassOptions" class="form-control">
                            <option value="">— Optional —</option>
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="SubjectId" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <select asp-for="SubjectId" asp-items="Model.SubjectOptions" class="form-control">
                            <option value="">— Optional —</option>
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="TeacherId" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <select asp-for="TeacherId" asp-items="Model.TeacherOptions" class="form-control">
                            <option value="">— Unassigned —</option>
                        </select>
                    </div>
                </div>

                <div class="form-group row">
                    <label class="col-sm-3 col-form-label label-control">Schedule</label>
                    <div class="col-sm-9">
                        <div class="row">
                            <div class="col-md-6">
                                <input asp-for="StartDate" class="form-control" type="date" placeholder="Start" />
                            </div>
                            <div class="col-md-6 mt-1 mt-md-0">
                                <input asp-for="EndDate" class="form-control" type="date" placeholder="End" />
                            </div>
                        </div>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Capacity" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="Capacity" class="form-control" type="number" min="1" max="1000" />
                        <span asp-validation-for="Capacity" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Description" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>

                <hr />
                <h5 class="mb-2"><i class="fa fa-money text-success mr-1"></i> Fees</h5>

                <div class="form-group row">
                    <label asp-for="CourseFee" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-4">
                        <input asp-for="CourseFee" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <label asp-for="MinimumEnrollment" class="col-sm-2 col-form-label label-control"></label>
                    <div class="col-sm-3">
                        <input asp-for="MinimumEnrollment" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="FullPaymentDiscountPercent" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="FullPaymentDiscountPercent" class="form-control" type="number" step="0.01" min="0" max="100" style="max-width:140px" />
                        <small class="text-muted">Optional incentive when a student clears the whole fee in one payment.</small>
                    </div>
                </div>

                <hr />
                <h5 class="mb-2"><i class="fa fa-globe text-primary mr-1"></i> Public catalog</h5>

                <div class="form-group row">
                    <div class="col-sm-9 offset-sm-3">
                        <div class="form-check">
                            <input asp-for="IsPublishedForEnrollment" class="form-check-input" />
                            <label asp-for="IsPublishedForEnrollment" class="form-check-label"></label>
                            <small class="text-muted d-block">When ticked, the batch appears on the public <code>/Courses</code> catalog and students can self-enroll.</small>
                        </div>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="ShortDescription" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="ShortDescription" class="form-control" maxlength="500" placeholder="One-liner shown in the catalog card" />
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="CoverImageUrl" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="CoverImageUrl" class="form-control" placeholder="https://…/cover.jpg" />
                        <small class="text-muted">A square or 16:9 hero image works best (≥800px wide).</small>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="PromoVideoUrl" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="PromoVideoUrl" class="form-control" placeholder="https://www.youtube.com/watch?v=…" />
                        <small class="text-muted">YouTube, Vimeo or Drive link — embedded on the public course page.</small>
                    </div>
                </div>

                <hr />
                <h5 class="mb-2"><i class="fa fa-tag text-danger mr-1"></i> Limited-time offer</h5>
                <div class="form-group row">
                    <label asp-for="OfferLabel" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="OfferLabel" class="form-control" maxlength="80" placeholder="e.g. Early-bird, Eid Sale, Save 20%" />
                        <small class="text-muted">Shown as a colored ribbon on catalog cards. Leave blank to hide.</small>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="OfferedPrice" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-4">
                        <input asp-for="OfferedPrice" class="form-control" type="number" step="0.01" min="0" placeholder="Discounted price" />
                    </div>
                    <label asp-for="OfferEndsAt" class="col-sm-2 col-form-label label-control"></label>
                    <div class="col-sm-3">
                        <input asp-for="OfferEndsAt" class="form-control" type="date" />
                    </div>
                </div>

                <hr />
                <h5 class="mb-2"><i class="fa fa-video-camera text-info mr-1"></i> Delivery mode</h5>

                <div class="form-group row">
                    <label asp-for="DeliveryMode" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <select asp-for="DeliveryMode" class="form-control" style="max-width:200px"
                                asp-items="Html.GetEnumSelectList<OptimumCoaching.core.DeliveryMode>()"></select>
                        <small class="text-muted">Online/Hybrid batches show a "Join live" button on dashboards.</small>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="MeetingUrl" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="MeetingUrl" class="form-control" placeholder="https://zoom.us/j/… or https://meet.google.com/…" />
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="MeetingNotes" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <textarea asp-for="MeetingNotes" class="form-control" rows="2" placeholder="Passcode, dial-in, etc."></textarea>
                    </div>
                </div>

                <hr />
                <h5 class="mb-2"><i class="fa fa-clock-o text-warning mr-1"></i> Late-fee policy</h5>

                <div class="form-group row">
                    <label asp-for="FeeDueDate" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-4">
                        <input asp-for="FeeDueDate" class="form-control" type="date" />
                    </div>
                    <label asp-for="FeeDueDays" class="col-sm-2 col-form-label label-control"></label>
                    <div class="col-sm-3">
                        <input asp-for="FeeDueDays" class="form-control" type="number" min="0" />
                        <small class="text-muted">Used when no absolute date is set.</small>
                    </div>
                </div>
                <div class="form-group row">
                    <label asp-for="LateFeeFlat" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-4">
                        <input asp-for="LateFeeFlat" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                    <label asp-for="LateFeePerDay" class="col-sm-2 col-form-label label-control"></label>
                    <div class="col-sm-3">
                        <input asp-for="LateFeePerDay" class="form-control" type="number" step="0.01" min="0" />
                    </div>
                </div>
            </div>
            <div class="card-footer text-right">
                <a class="btn btn-custom-default btn-medium mr-1" asp-action="Index">
                    <i class="fa fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn btn-custom btn-medium">
                    <i class="fa fa-save"></i> @(Model.Id == Guid.Empty ? "Create Batch" : "Save Changes")
                </button>
            </div>
        </div>
    </div>
</div>
