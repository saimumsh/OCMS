@model IList<BatchListItem>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Batches";
    var activeDepartmentId = ViewBag.ActiveDepartmentId as Guid?;
    var departmentOptions = (IEnumerable<SelectListItem>)ViewBag.DepartmentOptions;
    var groups = Model.GroupBy(b => new { b.DepartmentId, b.DepartmentName }).OrderBy(g => g.Key.DepartmentName).ToList();
}

<div class="content-header row">
    <div class="content-header-left col-md-8 col-12 mb-1">
        <h3 class="content-header-title mb-0">Batches</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Configuration</li>
                    <li class="breadcrumb-item active">Batches</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-4 col-12 mb-1 text-md-right">
        <form method="get" asp-action="Index" class="d-inline-block mr-1">
            <select name="departmentId" class="form-control form-control-sm d-inline-block w-auto"
                    onchange="this.form.submit()">
                <option value="">All departments</option>
                @foreach (var opt in departmentOptions)
                {
                    <option value="@opt.Value" selected="@(activeDepartmentId?.ToString() == opt.Value)">@opt.Text</option>
                }
            </select>
        </form>
        <a class="btn btn-custom btn-medium" asp-action="Create" asp-route-departmentId="@activeDepartmentId">
            <i class="fa fa-plus"></i> Add Batch
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-3">
            <p class="text-muted mb-1">No batches yet.</p>
            <a class="btn btn-custom btn-medium" asp-action="Create" asp-route-departmentId="@activeDepartmentId">
                <i class="fa fa-plus"></i> Create the first batch
            </a>
        </div>
    </div>
}
else
{
    foreach (var grp in groups)
    {
        <div class="card mb-2">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">
                    @(grp.Key.DepartmentName ?? "Unassigned department")
                    <span class="badge badge-pill badge-secondary ml-1">@grp.Count()</span>
                </h4>
                <a class="btn btn-sm btn-custom" asp-action="Create" asp-route-departmentId="@grp.Key.DepartmentId">
                    <i class="fa fa-plus"></i> Add to this department
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-condensed mb-0 user-table">
                        <thead>
                            <tr>
                                <th class="serial">#</th>
                                <th>Batch</th>
                                <th>Class / Subject</th>
                                <th>Teacher</th>
                                <th>Schedule</th>
                                <th class="text-center">Enrolled</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 0; }
                            @foreach (var b in grp.OrderBy(x => x.Name))
                            {
                                sn++;
                                <tr>
                                    <td class="align-middle">@sn</td>
                                    <td class="align-middle">
                                        <div class="font-weight-bold">@b.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(b.Code))
                                        { <small class="badge badge-light">@b.Code</small> }
                                    </td>
                                    <td class="align-middle">
                                        <div>@(b.ClassName ?? "—")</div>
                                        @if (!string.IsNullOrWhiteSpace(b.SubjectName))
                                        { <small class="text-muted">@b.SubjectName</small> }
                                    </td>
                                    <td class="align-middle">@(b.TeacherName ?? "—")</td>
                                    <td class="align-middle">
                                        @if (b.StartDate.HasValue || b.EndDate.HasValue)
                                        {
                                            <small>
                                                @(b.StartDate?.ToString("dd MMM yyyy") ?? "?") &mdash;
                                                @(b.EndDate?.ToString("dd MMM yyyy") ?? "?")
                                            </small>
                                        }
                                        else
                                        { <small class="text-muted">—</small> }
                                    </td>
                                    <td class="align-middle text-center">
                                        @b.EnrolledCount@(b.Capacity.HasValue ? $" / {b.Capacity}" : "")
                                    </td>
                                    <td class="align-middle text-right action-cell">
                                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@b.Id" title="Details">
                                            <i class="fa fa-eye"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@b.Id" class="d-inline"
                                              onsubmit="return confirm('Remove @b.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
