@model IList<OptimumCoaching.core.Exam>
@using Microsoft.AspNetCore.Mvc.Rendering
@{
    ViewData["Title"] = "Exams";
    var batchOptions = (IList<SelectListItem>)ViewBag.BatchOptions;
    var activeBatch = ViewBag.ActiveBatchId as Guid?;
    var canAdd = User.Identity != null && User.Identity.HasPermission(OptimumCoaching.core.Permissions.Exams.AddEdit);
    var canDelete = User.Identity != null && User.Identity.HasPermission(OptimumCoaching.core.Permissions.Exams.Delete);
    var canPublish = User.Identity != null && User.Identity.HasPermission(OptimumCoaching.core.Permissions.Exams.Publish);
    var canGrade = User.Identity != null && User.Identity.HasPermission(OptimumCoaching.core.Permissions.Results.Grade);
}

<div class="content-header row">
    <div class="content-header-left col-md-7 col-12 mb-1">
        <h3 class="content-header-title mb-0"><i class="fa fa-pencil-square-o mr-1 text-primary"></i> Exams</h3>
    </div>
    <div class="content-header-right col-md-5 col-12 mb-1 text-md-right">
        <form method="get" class="form-inline justify-content-md-end mb-1 d-inline-block">
            <select name="batchId" class="form-control form-control-sm mr-1" onchange="this.form.submit()">
                <option value="">All batches</option>
                @foreach (var o in batchOptions)
                {
                    if (Guid.TryParse(o.Value, out var g) && activeBatch == g)
                    { <option value="@o.Value" selected>@o.Text</option> }
                    else
                    { <option value="@o.Value">@o.Text</option> }
                }
            </select>
            @if (canAdd)
            { <a class="btn btn-sm btn-custom" asp-action="Create" asp-route-batchId="@activeBatch"><i class="fa fa-plus"></i> New Exam</a> }
        </form>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"]   != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center py-3"><p class="text-muted mb-0">No exams configured.</p></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-condensed mb-0 user-table">
                    <thead>
                        <tr>
                            <th class="serial">#</th>
                            <th>Title</th>
                            <th>Batch</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th>Total / Pass</th>
                            <th class="text-center">Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var sn = 0; }
                        @foreach (var e in Model)
                        {
                            sn++;
                            <tr>
                                <td class="align-middle">@sn</td>
                                <td class="align-middle"><strong>@e.Title</strong></td>
                                <td class="align-middle">@(e.Batch?.Name ?? "—")<div class="small text-muted">@(e.Batch?.Department?.Name ?? "")</div></td>
                                <td class="align-middle"><span class="badge badge-light">@e.Type</span></td>
                                <td class="align-middle">@e.ExamDate.ToString("dd MMM yyyy")</td>
                                <td class="align-middle">@e.TotalMarks / @e.PassMarks</td>
                                <td class="align-middle text-center">
                                    @switch (e.Status)
                                    {
                                        case OptimumCoaching.core.ExamStatus.Published:
                                            <span class="badge badge-pill badge-success">Published</span>
                                            break;
                                        case OptimumCoaching.core.ExamStatus.Cancelled:
                                            <span class="badge badge-pill badge-danger">Cancelled</span>
                                            break;
                                        default:
                                            <span class="badge badge-pill badge-secondary">Draft</span>
                                            break;
                                    }
                                </td>
                                <td class="align-middle text-right action-cell">
                                    @if (canGrade)
                                    {
                                        <a class="btn btn-sm btn-outline-info" asp-action="Grade" asp-route-id="@e.Id" title="Grade results">
                                            <i class="fa fa-list-ol"></i>
                                        </a>
                                    }
                                    @if (canAdd)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    }
                                    @if (canPublish && e.Status != OptimumCoaching.core.ExamStatus.Published)
                                    {
                                        <form method="post" asp-action="Publish" asp-route-id="@e.Id" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-success" title="Publish exam">
                                                <i class="fa fa-bullhorn"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (canDelete)
                                    {
                                        <form method="post" asp-action="Delete" asp-route-id="@e.Id" class="d-inline" onsubmit="return confirm('Remove this exam?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
