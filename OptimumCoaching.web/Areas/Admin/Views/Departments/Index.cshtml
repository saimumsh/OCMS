@model IList<DepartmentListItem>
@{
    ViewData["Title"] = "Departments";
    var activeStream = ViewBag.ActiveStream as EducationStream?;
    var groups = Model.GroupBy(d => d.Stream)
                      .OrderBy(g => g.Key)
                      .ToList();
}

<div class="content-header row">
    <div class="content-header-left col-md-8 col-12 mb-1">
        <h3 class="content-header-title mb-0">Departments</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Configuration</li>
                    <li class="breadcrumb-item active">Departments</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-4 col-12 mb-1 text-md-right">
        <div class="btn-group mr-1" role="group">
            <a class="btn btn-sm @(activeStream == null ? "btn-custom" : "btn-custom-default")" asp-action="Index">All</a>
            <a class="btn btn-sm @(activeStream == EducationStream.Academic ? "btn-custom" : "btn-custom-default")"
               asp-action="Index" asp-route-stream="@EducationStream.Academic">Academic</a>
            <a class="btn btn-sm @(activeStream == EducationStream.Diploma ? "btn-custom" : "btn-custom-default")"
               asp-action="Index" asp-route-stream="@EducationStream.Diploma">Diploma</a>
        </div>
        <a class="btn btn-custom btn-medium" asp-action="Create" asp-route-stream="@activeStream">
            <i class="fa fa-plus"></i> Add Department
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-3"><p class="text-muted mb-0">No departments configured.</p></div>
    </div>
}
else
{
    foreach (var grp in groups)
    {
        var streamLabel = grp.Key == EducationStream.Diploma ? "Diploma" : "Academic";
        var streamHelp = grp.Key == EducationStream.Diploma
            ? "Engineering & technical specializations (Electrical, Computer, etc.)"
            : "General education tracks (Science, Arts, Commerce)";

        <div class="card mb-2">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
                <div>
                    <h4 class="card-title mb-0">
                        @streamLabel <span class="badge badge-pill badge-secondary ml-1">@grp.Count()</span>
                    </h4>
                    <small class="text-muted">@streamHelp</small>
                </div>
                <a class="btn btn-sm btn-custom" asp-action="Create" asp-route-stream="@grp.Key">
                    <i class="fa fa-plus"></i> Add to @streamLabel
                </a>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover table-condensed mb-0 user-table">
                        <thead>
                            <tr>
                                <th class="serial">#</th>
                                <th>Name</th>
                                <th>Code</th>
                                <th>Description</th>
                                <th class="text-center">Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 0; }
                            @foreach (var d in grp)
                            {
                                sn++;
                                <tr>
                                    <td class="align-middle">@sn</td>
                                    <td class="align-middle"><strong>@d.Name</strong></td>
                                    <td class="align-middle"><span class="badge badge-light">@(d.Code ?? "—")</span></td>
                                    <td class="align-middle">@(d.Description ?? "—")</td>
                                    <td class="align-middle text-center">
                                        @if (d.IsActive)
                                        { <span class="badge badge-pill badge-success">Active</span> }
                                        else
                                        { <span class="badge badge-pill badge-secondary">Inactive</span> }
                                    </td>
                                    <td class="align-middle text-right action-cell">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@d.Id" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@d.Id" class="d-inline"
                                              onsubmit="return confirm('Remove @d.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
}
