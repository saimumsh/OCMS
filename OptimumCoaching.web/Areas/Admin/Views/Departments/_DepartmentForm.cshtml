@model DepartmentFormViewModel
@using OptimumCoaching.web.Areas.Admin.Controllers
@{
    var isEdit = Model.Id != Guid.Empty;
    var academicPresets = DepartmentsController.Presets[EducationStream.Academic];
    var diplomaPresets = DepartmentsController.Presets[EducationStream.Diploma];
}

<input asp-for="Id" type="hidden" />

<div class="row">
    <div class="col-lg-7">
        <div class="card">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                <h4 class="card-title mb-0">@(isEdit ? "Edit Department" : "New Department")</h4>
            </div>
            <div class="card-body">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-1"></div>

                <div class="form-group row">
                    <label asp-for="Stream" class="col-sm-3 col-form-label label-control required"></label>
                    <div class="col-sm-9">
                        <select asp-for="Stream" id="StreamSelect" class="form-control"
                                asp-items="Html.GetEnumSelectList<EducationStream>()"></select>
                        <small class="text-muted">
                            <strong>Academic</strong>: Science / Arts / Commerce.
                            <strong>Diploma</strong>: Electrical / Electronics / Computer / Civil / Mechanical / etc.
                        </small>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Name" class="col-sm-3 col-form-label label-control required"></label>
                    <div class="col-sm-9">
                        <input asp-for="Name" id="NameInput" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                        <div id="presetSuggest" class="mt-1">
                            <small class="text-muted mr-1">Suggested:</small>
                            <span id="presetButtons"></span>
                        </div>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Code" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <input asp-for="Code" class="form-control" placeholder="Optional short code, e.g. ACA-SCI, DIP-EE" />
                        <span asp-validation-for="Code" class="text-danger"></span>
                    </div>
                </div>

                <div class="form-group row">
                    <label asp-for="Description" class="col-sm-3 col-form-label label-control"></label>
                    <div class="col-sm-9">
                        <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    </div>
                </div>
            </div>
            <div class="card-footer text-right">
                <a class="btn btn-custom-default btn-medium mr-1" asp-action="Index">
                    <i class="fa fa-times"></i> Cancel
                </a>
                <button type="submit" class="btn btn-custom btn-medium">
                    <i class="fa fa-save"></i> @(isEdit ? "Save Changes" : "Create Department")
                </button>
            </div>
        </div>
    </div>
</div>

<script>
    (function () {
        var presets = {
            "@((int)EducationStream.Academic)": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(academicPresets)),
            "@((int)EducationStream.Diploma)":  @Html.Raw(System.Text.Json.JsonSerializer.Serialize(diplomaPresets))
        };
        var stream = document.getElementById('StreamSelect');
        var nameInput = document.getElementById('NameInput');
        var btnHost = document.getElementById('presetButtons');
        if (!stream || !nameInput || !btnHost) return;

        function render() {
            btnHost.innerHTML = '';
            var list = presets[stream.value] || [];
            list.forEach(function (name) {
                var b = document.createElement('button');
                b.type = 'button';
                b.className = 'btn btn-sm btn-outline-secondary mr-1 mb-1';
                b.textContent = name;
                b.addEventListener('click', function () { nameInput.value = name; nameInput.focus(); });
                btnHost.appendChild(b);
            });
        }
        stream.addEventListener('change', render);
        render();
    })();
</script>
