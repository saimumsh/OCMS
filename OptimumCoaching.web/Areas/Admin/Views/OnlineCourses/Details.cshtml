@model OnlineCourseDetailsViewModel
@using OptimumCoaching.core
@{
    var b = Model.Batch;
    ViewData["Title"] = $"Online Course — {b.Name}";
    var img = string.IsNullOrWhiteSpace(b.CoverImageUrl) ? "/images/no-image.jpg" : b.CoverImageUrl;
    var today = DateTime.UtcNow.Date;
    var offerActive = b.OfferedPrice.HasValue && b.OfferedPrice.Value < b.CourseFee
                      && (!b.OfferEndsAt.HasValue || b.OfferEndsAt.Value.Date >= today);
}

<div class="content-header row">
    <div class="content-header-left col-md-8 col-12 mb-1">
        <h3 class="content-header-title mb-0">
            <i class="fa fa-video-camera text-info mr-1"></i> @b.Name
            <span class="badge badge-pill @(b.DeliveryMode == DeliveryMode.Online ? "badge-success" : "badge-info") ml-1">@b.DeliveryMode</span>
            @if (b.IsPublishedForEnrollment && b.IsActive)
            { <span class="badge badge-pill badge-primary ml-1">Published</span> }
            else
            { <span class="badge badge-pill badge-secondary ml-1">Draft</span> }
        </h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Online Courses</a></li>
                    <li class="breadcrumb-item active">@b.Name</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-4 col-12 mb-1 text-md-right">
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@b.Id"><i class="fa fa-edit mr-1"></i>Edit</a>
        <a class="btn btn-outline-secondary" asp-controller="Courses" asp-area="" asp-action="Details" asp-route-id="@b.Id" target="_blank">
            <i class="fa fa-external-link mr-1"></i> Public page
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"]   != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<div class="row">
    <div class="col-md-4 mb-2">
        <div class="card">
            <img src="@img" alt="@b.Name" style="width:100%; height:200px; object-fit:cover;" />
            <div class="card-body">
                <dl class="row mb-0 small">
                    <dt class="col-5 text-muted">Department</dt>
                    <dd class="col-7">@(b.Department?.Name ?? "—")</dd>

                    <dt class="col-5 text-muted">Subject</dt>
                    <dd class="col-7">@(b.Subject?.Name ?? "—")</dd>

                    <dt class="col-5 text-muted">Teacher</dt>
                    <dd class="col-7">@(b.Teacher?.FullName ?? "—")</dd>

                    <dt class="col-5 text-muted">Capacity</dt>
                    <dd class="col-7">@(b.Capacity?.ToString() ?? "Unlimited")</dd>

                    <dt class="col-5 text-muted">Course fee</dt>
                    <dd class="col-7">
                        @if (offerActive)
                        {
                            <span class="text-muted" style="text-decoration:line-through">৳ @b.CourseFee.ToString("N0")</span>
                            <strong class="text-danger ml-1">৳ @b.OfferedPrice!.Value.ToString("N0")</strong>
                        }
                        else
                        {
                            <strong>৳ @b.CourseFee.ToString("N0")</strong>
                        }
                    </dd>

                    @if (!string.IsNullOrWhiteSpace(b.MeetingUrl))
                    {
                        <dt class="col-5 text-muted">Meeting link</dt>
                        <dd class="col-7"><a href="@b.MeetingUrl" target="_blank">Open</a></dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    <div class="col-md-8 mb-2">
        <div class="row">
            <div class="col-md-4 mb-2">
                <div class="card text-center">
                    <div class="card-body p-2">
                        <h3 class="mb-0">@Model.Enrollments.Count</h3>
                        <small class="text-muted">Total enrollments</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <div class="card text-center">
                    <div class="card-body p-2">
                        <h3 class="mb-0 text-success">৳ @Model.RevenuePaid.ToString("N0")</h3>
                        <small class="text-muted">Revenue collected</small>
                    </div>
                </div>
            </div>
            <div class="col-md-4 mb-2">
                <div class="card text-center">
                    <div class="card-body p-2">
                        <h3 class="mb-0 text-warning">৳ @Model.RevenueOutstanding.ToString("N0")</h3>
                        <small class="text-muted">Outstanding</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
                <h4 class="card-title mb-0">
                    <i class="fa fa-users mr-1 text-primary"></i> Enrolled students
                    <span class="badge badge-pill badge-secondary ml-1">@Model.Enrollments.Count</span>
                </h4>
                <span class="badge badge-pill badge-light"><i class="fa fa-play-circle mr-1"></i>@Model.LessonsCount lessons</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Enrollments.Any())
                {
                    <p class="text-muted text-center py-3 mb-0">No enrollments yet.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th>Student</th>
                                    <th>Department</th>
                                    <th class="text-right">Price</th>
                                    <th>Enrolled</th>
                                    <th>Status</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in Model.Enrollments)
                                {
                                    var statusBadge = e.Status switch
                                    {
                                        EnrollmentStatus.Active    => ("badge-success", "Active"),
                                        EnrollmentStatus.Cancelled => ("badge-danger",  "Cancelled"),
                                        EnrollmentStatus.Completed => ("badge-info",    "Completed"),
                                        _                          => ("badge-warning", "Suspended")
                                    };
                                    <tr>
                                        <td>
                                            <strong>@e.Student.FullName</strong>
                                            @if (!string.IsNullOrWhiteSpace(e.Student.StudentCode))
                                            { <small class="badge badge-light ml-1">@e.Student.StudentCode</small> }
                                        </td>
                                        <td><small>@(e.Student.Department?.Name ?? "—")</small></td>
                                        <td class="text-right">৳ @e.PriceAtEnrollment.ToString("N0")</td>
                                        <td><small>@e.EnrolledOn.ToString("dd MMM yyyy")</small></td>
                                        <td><span class="badge badge-pill @statusBadge.Item1">@statusBadge.Item2</span></td>
                                        <td class="text-right">
                                            @if (e.Status == EnrollmentStatus.Active)
                                            {
                                                <form asp-action="CancelEnrollment" method="post" class="d-inline"
                                                      onsubmit="return confirm('Cancel this enrollment?');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="id" value="@e.Id" />
                                                    <input type="hidden" name="batchId" value="@b.Id" />
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fa fa-times"></i>
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
