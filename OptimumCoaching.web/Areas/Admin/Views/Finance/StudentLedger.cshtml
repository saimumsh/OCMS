@model IList<OptimumCoaching.core.StudentFeeAccount>
@using OptimumCoaching.core
@{
    var student = (Student)ViewBag.Student;
    ViewData["Title"] = $"Ledger — {student.FullName}";
    var canRecord = User.Identity != null && User.Identity.HasPermission(Permissions.Finance.RecordPayment);
    var canManage = User.Identity != null && User.Identity.HasPermission(Permissions.Finance.ManageFees);
    var enabledMethods = ViewBag.EnabledMethods as ISet<PaymentMethod>;
    var methods = enabledMethods != null && enabledMethods.Count > 0
        ? Enum.GetValues<PaymentMethod>().Where(m => enabledMethods.Contains(m)).ToArray()
        : Enum.GetValues<PaymentMethod>();

    var totalFinal = Model.Sum(a => a.FinalFee);
    var totalPaid  = Model.Sum(a => a.AmountPaid);
    var totalBal   = totalFinal - totalPaid;
}

<div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-1">
        <h3 class="content-header-title mb-0">
            <i class="fa fa-book mr-1 text-info"></i> @student.FullName
            @if (!string.IsNullOrWhiteSpace(student.StudentCode))
            { <span class="badge badge-light ml-1">@student.StudentCode</span> }
        </h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Students">Student Fees</a></li>
                    <li class="breadcrumb-item active">@student.FullName</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-3 col-12 mb-1 text-md-right">
        <a class="btn btn-sm btn-custom-default" asp-action="Students"><i class="fa fa-arrow-left"></i> Back</a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null) { <div class="alert alert-success">@TempData["SuccessMessage"]</div> }
@if (TempData["ErrorMessage"]   != null) { <div class="alert alert-danger">@TempData["ErrorMessage"]</div> }

<section class="oc-stats row">
    <div class="col-6 col-md-4 mb-2">
        <div class="oc-stat oc-stat--info">
            <div class="oc-stat__icon"><i class="fa fa-money"></i></div>
            <div>
                <div class="oc-stat__value">@totalFinal.ToString("N0")</div>
                <div class="oc-stat__label">Total fee</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 mb-2">
        <div class="oc-stat oc-stat--success">
            <div class="oc-stat__icon"><i class="fa fa-check"></i></div>
            <div>
                <div class="oc-stat__value">@totalPaid.ToString("N0")</div>
                <div class="oc-stat__label">Total paid</div>
            </div>
        </div>
    </div>
    <div class="col-6 col-md-4 mb-2">
        <div class="oc-stat oc-stat--warning">
            <div class="oc-stat__icon"><i class="fa fa-clock-o"></i></div>
            <div>
                <div class="oc-stat__value">@totalBal.ToString("N0")</div>
                <div class="oc-stat__label">Total balance</div>
            </div>
        </div>
    </div>
</section>

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center py-3"><p class="text-muted mb-0">No fee accounts yet for this student.</p></div></div>
    return;
}

@foreach (var a in Model)
{
    var statusBadge = a.Status switch
    {
        FeeAccountStatus.PaidInFull    => ("badge-success",  "Paid in full"),
        FeeAccountStatus.PartiallyPaid => ("badge-info",     "Partial"),
        FeeAccountStatus.Overdue       => ("badge-danger",   "Overdue"),
        FeeAccountStatus.Waived        => ("badge-secondary","Waived"),
        _                              => ("badge-warning",  "Unpaid")
    };
    var paidPct = a.FinalFee > 0 ? (int)Math.Round(a.AmountPaid / a.FinalFee * 100) : 100;

    <div class="card mb-2">
        <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center flex-wrap">
            <div>
                <h4 class="card-title mb-0">@a.Batch.Name
                    @if (!string.IsNullOrWhiteSpace(a.Batch.Code))
                    { <span class="badge badge-light ml-1">@a.Batch.Code</span> }
                </h4>
                <small class="text-muted">
                    Course fee <strong>@a.Batch.CourseFee.ToString("N0")</strong>
                    @if (a.DiscountAmount > 0)
                    { <text> · Discount <strong>@a.DiscountAmount.ToString("N0")</strong></text> }
                    · Final <strong>@a.FinalFee.ToString("N0")</strong>
                    · Paid <strong>@a.AmountPaid.ToString("N0")</strong>
                    · Balance <strong>@a.Balance.ToString("N0")</strong>
                </small>
            </div>
            <span class="badge badge-pill @statusBadge.Item1">@statusBadge.Item2</span>
        </div>

        <div class="card-body">
            <div class="progress mb-2" style="height: 6px;">
                <div class="progress-bar bg-success" style="width: @paidPct%"></div>
            </div>

            @if (!string.IsNullOrWhiteSpace(a.DiscountReason))
            { <p class="small text-muted mb-2">Discount reason: @a.DiscountReason</p> }

            @if (a.Payments.Any())
            {
                <h6 class="mt-2 mb-1">Payment history</h6>
                <table class="table table-condensed table-sm mb-0">
                    <thead>
                        <tr>
                            <th>Date</th>
                            <th class="text-right">Amount</th>
                            <th>Method</th>
                            <th>Receipt</th>
                            <th>Note</th>
                            <th>By</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in a.Payments)
                        {
                            <tr>
                                <td>@p.PaidOn.ToString("dd MMM yyyy")</td>
                                <td class="text-right">@p.Amount.ToString("N2")</td>
                                <td><span class="badge badge-light">@p.Method</span></td>
                                <td>@(p.ReceiptNumber ?? "—")</td>
                                <td>@(p.Note ?? "—")</td>
                                <td class="small text-muted">@(p.RecordedByUser?.FullName ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
            else
            { <p class="text-muted small mb-0">No payments recorded yet.</p> }
        </div>

        @if (canRecord && a.Balance > 0)
        {
            <div class="card-footer">
                <form method="post" asp-action="RecordPayment" class="form-inline align-items-end">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="accountId" value="@a.Id" />
                    <input type="hidden" name="studentId" value="@student.Id" />
                    <div class="form-group mr-1 mb-1">
                        <label class="d-block small">Amount</label>
                        <input name="amount" type="number" step="0.01" min="0.01" max="@a.Balance"
                               class="form-control form-control-sm" required style="width:130px" />
                    </div>
                    <div class="form-group mr-1 mb-1">
                        <label class="d-block small">Date</label>
                        <input name="paidOn" type="date" class="form-control form-control-sm"
                               value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="form-group mr-1 mb-1">
                        <label class="d-block small">Method</label>
                        <select name="method" class="form-control form-control-sm">
                            @foreach (var m in methods) { <option value="@((int)m)">@m</option> }
                        </select>
                    </div>
                    <div class="form-group mr-1 mb-1">
                        <label class="d-block small">Receipt #</label>
                        <input name="receiptNumber" class="form-control form-control-sm" />
                    </div>
                    <div class="form-group mr-1 mb-1 flex-grow-1">
                        <label class="d-block small">Note</label>
                        <input name="note" class="form-control form-control-sm" />
                    </div>
                    <button type="submit" class="btn btn-custom btn-sm mb-1">
                        <i class="fa fa-check"></i> Record payment
                    </button>
                </form>

                @if (canManage)
                {
                    <form method="post" asp-action="ApplyDiscount" class="form-inline align-items-end mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="accountId" value="@a.Id" />
                        <input type="hidden" name="studentId" value="@student.Id" />
                        <div class="form-group mr-1 mb-1">
                            <label class="d-block small">Discount</label>
                            <input name="discountAmount" type="number" step="0.01" min="0"
                                   value="@a.DiscountAmount" class="form-control form-control-sm" required style="width:140px" />
                        </div>
                        <div class="form-group mr-1 mb-1 flex-grow-1">
                            <label class="d-block small">Reason</label>
                            <input name="reason" value="@a.DiscountReason" class="form-control form-control-sm"
                                   placeholder="e.g. Result-based discount, scholarship" />
                        </div>
                        <button type="submit" class="btn btn-warning btn-sm mb-1">
                            <i class="fa fa-percent"></i> Apply discount
                        </button>
                    </form>
                }
            </div>
        }
    </div>
}
