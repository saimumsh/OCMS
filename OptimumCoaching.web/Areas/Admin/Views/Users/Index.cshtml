@model IList<UserListItem>
@{
    ViewData["Title"] = "Users";
    var activeRole  = ViewBag.ActiveRole as string;
    var roleCounts  = ViewBag.RoleCounts as Dictionary<string, int> ?? new();
    var totalCount  = (int)(ViewBag.TotalCount ?? Model.Count);

    // Order the tabs from most-privileged to least so admins see structure first.
    var roleTabs = new[]
    {
        Roles.SuperAdmin,
        Roles.Dev,
        Roles.Admin,
        Roles.CC,
        Roles.Teacher,
        Roles.User
    };

    string TabClass(string? r) =>
        string.Equals(activeRole, r, StringComparison.OrdinalIgnoreCase)
            ? "btn-custom"
            : "btn-custom-default";
}

<div class="content-header row">
    <div class="content-header-left col-md-7 col-12 mb-1">
        <h3 class="content-header-title mb-0">Users</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Administration</li>
                    <li class="breadcrumb-item active">
                        Users@(string.IsNullOrEmpty(activeRole) ? "" : $" — {activeRole}")
                    </li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-5 col-12 mb-1 text-md-right">
        <a class="btn btn-custom btn-medium" asp-action="Create">
            <i class="fa fa-plus"></i> New User
        </a>
    </div>
</div>

<div class="row mb-1">
    <div class="col-12">
        <div class="btn-group flex-wrap" role="group" aria-label="Filter users by role">
            <a class="btn btn-sm @TabClass(null)" asp-action="Index">
                All <span class="badge badge-pill badge-light ml-1">@totalCount</span>
            </a>
            @foreach (var r in roleTabs)
            {
                var count = roleCounts.GetValueOrDefault(r);
                <a class="btn btn-sm @TabClass(r)" asp-action="Index" asp-route-role="@r">
                    @r <span class="badge badge-pill badge-light ml-1">@count</span>
                </a>
            }
        </div>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<section id="users-list">
    <div class="card">
        <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">
                @(string.IsNullOrEmpty(activeRole) ? "All Users" : $"{activeRole} Users")
                <span class="badge badge-pill badge-secondary ml-1">@Model.Count</span>
            </h4>
            <div class="user-search">
                <input type="search" id="userSearch" class="form-control form-control-sm"
                       placeholder="Search by name, email or role..." />
            </div>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-3">
                    <p class="text-muted mb-1">No users yet.</p>
                    <a class="btn btn-custom btn-medium" asp-action="Create">
                        <i class="fa fa-plus"></i> Create the first user
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-condensed mb-0 user-table">
                        <thead>
                            <tr>
                                <th class="serial">#</th>
                                <th>User</th>
                                <th>Email</th>
                                <th>Roles</th>
                                <th class="text-center">Status</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 0; }
                            @foreach (var u in Model)
                            {
                                sn++;
                                var avatar = string.IsNullOrWhiteSpace(u.ImageUrl) ? "/images/no-image.jpg" : Url.Content(u.ImageUrl);
                                var initials = string.Concat(u.FullName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(p => char.ToUpper(p[0])));
                                <tr class="user-row">
                                    <td class="align-middle">@sn</td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <span class="user-avatar mr-1">
                                                @if (!string.IsNullOrWhiteSpace(u.ImageUrl))
                                                {
                                                    <img src="@avatar" alt="@u.FullName" />
                                                }
                                                else
                                                {
                                                    <span class="user-avatar-initials">@initials</span>
                                                }
                                            </span>
                                            <div>
                                                <div class="font-weight-bold">@u.FullName</div>
                                                <small class="text-muted">@(u.IsActive ? "Active account" : "Account disabled")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        <a href="mailto:@u.Email" class="text-decoration-none">@u.Email</a>
                                    </td>
                                    <td class="align-middle">
                                        @if (u.Roles.Any())
                                        {
                                            foreach (var r in u.Roles)
                                            {
                                                <span class="badge badge-pill badge-info mr-1 mb-1">@r</span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td class="align-middle text-center">
                                        @{
                                            var statusClass = u.IsActive
                                                ? u.Status switch
                                                {
                                                    ApplicationUserStatus.Active => "badge-success",
                                                    ApplicationUserStatus.Suspended => "badge-warning",
                                                    _ => "badge-secondary"
                                                }
                                                : "badge-danger";
                                            var statusLabel = u.IsActive ? u.Status.ToString() : "Inactive";
                                        }
                                        <span class="badge badge-pill @statusClass">@statusLabel</span>
                                    </td>
                                    <td class="align-middle text-right action-cell">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        <a class="btn btn-sm btn-outline-warning" asp-action="ResetPassword" asp-route-id="@u.Id" title="Reset password">
                                            <i class="fa fa-key"></i>
                                        </a>
                                        <form method="post" asp-action="Delete" asp-route-id="@u.Id" class="d-inline"
                                              onsubmit="return confirm('Deactivate @u.FullName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Deactivate">
                                                <i class="fa fa-ban"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('userSearch');
            if (!input) return;
            var rows = document.querySelectorAll('.user-table tbody tr');
            input.addEventListener('input', function () {
                var term = this.value.toLowerCase().trim();
                rows.forEach(function (row) {
                    row.style.display = term === '' || row.textContent.toLowerCase().indexOf(term) !== -1 ? '' : 'none';
                });
            });
        })();
    </script>
}
