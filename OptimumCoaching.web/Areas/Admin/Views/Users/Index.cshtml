@model IList<UserListItem>
@{
    ViewData["Title"] = "Users";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Users</h2>
    <a class="btn btn-primary" asp-action="Create">+ New User</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Email</th>
            <th>Roles</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var u in Model)
    {
        <tr>
            <td>@u.FullName</td>
            <td>@u.Email</td>
            <td>
                @foreach (var r in u.Roles)
                {
                    <span class="badge bg-secondary me-1">@r</span>
                }
            </td>
            <td>
                @if (u.IsActive)
                {
                    <span class="badge bg-success">@u.Status</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactive</span>
                }
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                <a class="btn btn-sm btn-outline-warning" asp-action="ResetPassword" asp-route-id="@u.Id">Reset Password</a>
                <form method="post" asp-action="Delete" asp-route-id="@u.Id" class="d-inline"
                      onsubmit="return confirm('Deactivate this user?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Deactivate</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
