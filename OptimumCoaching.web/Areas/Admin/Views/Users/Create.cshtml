@model CreateUserViewModel
@{
    ViewData["Title"] = "New User";
}

<div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-1">
        <h3 class="content-header-title mb-0">New User</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Users</a></li>
                    <li class="breadcrumb-item active">New User</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section id="user-create">
    <form method="post" asp-action="Create" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-lg-4 col-md-5 mb-3">
                <div class="card user-photo-card">
                    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                        <h4 class="card-title mb-0">Profile Picture</h4>
                    </div>
                    <div class="card-body text-center">
                        <div class="user-photo-preview mb-2">
                            <img id="userPhotoPreview" src="~/images/no-image.jpg" alt="profile preview" />
                        </div>
                        <label class="btn btn-custom btn-medium mb-1" for="Image">
                            <i class="fa fa-camera"></i> Choose Photo
                        </label>
                        <input type="file" asp-for="Image" id="Image" accept="image/*"
                               class="d-none" onchange="previewUserPhoto(this)" />
                        <span asp-validation-for="Image" class="text-danger d-block"></span>
                        <p class="text-muted font-small-3 mt-1 mb-0">
                            JPG, PNG, GIF or WebP &middot; up to 4 MB
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-md-7 mb-3">
                <div class="card">
                    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                        <h4 class="card-title mb-0">Account Details</h4>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-1"></div>

                        <div class="form-group row">
                            <label asp-for="FullName" class="col-sm-3 col-form-label label-control required"></label>
                            <div class="col-sm-9">
                                <input asp-for="FullName" class="form-control" placeholder="e.g. Alex Coach" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="Email" class="col-sm-3 col-form-label label-control required">Email</label>
                            <div class="col-sm-9">
                                <input asp-for="Email" class="form-control" placeholder="name@domain.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="Password" class="col-sm-3 col-form-label label-control required">Password</label>
                            <div class="col-sm-9">
                                <input asp-for="Password" class="form-control" type="password"
                                       placeholder="Minimum 5 characters" />
                                <span asp-validation-for="Password" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-1">
                    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                        <h4 class="card-title mb-0">Roles &amp; Access</h4>
                    </div>
                    <div class="card-body">
                        @if (Model.AllRoles.Any())
                        {
                            <div class="row">
                                @foreach (var role in Model.AllRoles)
                                {
                                    <div class="col-sm-6 col-md-4 mb-1">
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox"
                                                   name="SelectedRoles" value="@role"
                                                   id="role_@role"
                                                   @(Model.SelectedRoles.Contains(role) ? "checked" : "") />
                                            <label class="form-check-label" for="role_@role">@role</label>
                                        </div>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted mb-0">No roles available.</p>
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-1">
                    <a class="btn btn-custom-default btn-medium mr-1" asp-action="Index">
                        <i class="fa fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-custom btn-medium">
                        <i class="fa fa-save"></i> Create User
                    </button>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function previewUserPhoto(input) {
            var preview = document.getElementById('userPhotoPreview');
            if (input && input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { preview.src = e.target.result; };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
}
