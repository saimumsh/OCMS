@model IList<PermissionListRow>
@{
    ViewData["Title"] = "Permissions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2>Permissions</h2>
    <a class="btn btn-primary" asp-action="Create">+ New Permission</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<table class="table table-striped">
    <thead>
        <tr>
            <th>Category</th>
            <th>Name</th>
            <th>Display name</th>
            <th>Status</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@(p.Category ?? "-")</td>
            <td><code>@p.Name</code></td>
            <td>
                @p.DisplayName
                @if (!string.IsNullOrWhiteSpace(p.Description))
                {
                    <div class="text-muted small">@p.Description</div>
                }
            </td>
            <td>
                @if (p.IsActive)
                {
                    <span class="badge bg-success">Active</span>
                }
                else
                {
                    <span class="badge bg-secondary">Inactive</span>
                }
            </td>
            <td class="text-end">
                <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@p.Id">Edit</a>
                <form method="post" asp-action="Delete" asp-route-id="@p.Id" class="d-inline"
                      onsubmit="return confirm('Delete this permission and all role assignments?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
