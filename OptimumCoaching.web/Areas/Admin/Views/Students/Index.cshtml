@model IList<StudentListItem>
@{
    ViewData["Title"] = "Students";
}

<div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-1">
        <h3 class="content-header-title mb-0">Students</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Coaching</li>
                    <li class="breadcrumb-item active">Students</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-3 col-12 mb-1 text-md-right">
        <a class="btn btn-custom-default btn-medium mr-1" asp-action="Pending">
            <i class="fa fa-hourglass-half"></i> Pending
        </a>
        <a class="btn btn-custom btn-medium" asp-action="Create">
            <i class="fa fa-plus"></i> Add Student
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

<section id="students-list">
    <div class="card">
        <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
            <h4 class="card-title mb-0">All Students <span class="badge badge-pill badge-secondary ml-1">@Model.Count</span></h4>
            <div class="user-search">
                <input type="search" id="studentSearch" class="form-control form-control-sm"
                       placeholder="Search by name, email, guardian..." />
            </div>
        </div>
        <div class="card-body p-0">
            @if (!Model.Any())
            {
                <div class="text-center py-3"><p class="text-muted mb-0">No students yet.</p></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover table-condensed mb-0 user-table">
                        <thead>
                            <tr>
                                <th class="serial">#</th>
                                <th>Student</th>
                                <th>Contact</th>
                                <th>Guardian</th>
                                <th class="text-center">Approval</th>
                                <th class="text-right">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var sn = 0; }
                            @foreach (var s in Model)
                            {
                                sn++;
                                var avatar = string.IsNullOrWhiteSpace(s.ImageUrl) ? "/images/no-image.jpg" : Url.Content(s.ImageUrl);
                                var initials = string.Concat(s.FullName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2)
                                    .Select(p => char.ToUpper(p[0])));
                                <tr>
                                    <td class="align-middle">@sn</td>
                                    <td class="align-middle">
                                        <div class="d-flex align-items-center">
                                            <span class="user-avatar mr-1">
                                                @if (!string.IsNullOrWhiteSpace(s.ImageUrl))
                                                { <img src="@avatar" alt="@s.FullName" /> }
                                                else
                                                { <span class="user-avatar-initials">@initials</span> }
                                            </span>
                                            <div>
                                                <div class="font-weight-bold">@s.FullName</div>
                                                <small class="text-muted">Registered @s.Created.ToString("dd MMM yyyy")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td class="align-middle">
                                        @if (!string.IsNullOrWhiteSpace(s.Email))
                                        { <div><a href="mailto:@s.Email">@s.Email</a></div> }
                                        @if (!string.IsNullOrWhiteSpace(s.PhoneNumber))
                                        { <div><small class="text-muted">@s.PhoneNumber</small></div> }
                                    </td>
                                    <td class="align-middle">@(s.GuardianName ?? "—")</td>
                                    <td class="align-middle text-center">
                                        @{
                                            var (cls, label) = s.ApprovalStatus switch
                                            {
                                                StudentApprovalStatus.Approved => ("badge-success", "Approved"),
                                                StudentApprovalStatus.Pending => ("badge-warning", "Pending"),
                                                StudentApprovalStatus.Rejected => ("badge-danger", "Rejected"),
                                                _ => ("badge-secondary", s.ApprovalStatus.ToString())
                                            };
                                        }
                                        <span class="badge badge-pill @cls">@label</span>
                                    </td>
                                    <td class="align-middle text-right action-cell">
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@s.Id" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                        @if (s.ApprovalStatus == StudentApprovalStatus.Pending)
                                        {
                                            <form method="post" asp-action="Approve" asp-route-id="@s.Id" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success" title="Approve">
                                                    <i class="fa fa-check"></i>
                                                </button>
                                            </form>
                                            <a class="btn btn-sm btn-outline-warning" asp-action="Reject" asp-route-id="@s.Id" title="Reject">
                                                <i class="fa fa-times"></i>
                                            </a>
                                        }
                                        <form method="post" asp-action="Delete" asp-route-id="@s.Id" class="d-inline"
                                              onsubmit="return confirm('Remove @s.FullName?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</section>

@section Scripts {
    <script>
        (function () {
            var input = document.getElementById('studentSearch');
            if (!input) return;
            var rows = document.querySelectorAll('.user-table tbody tr');
            input.addEventListener('input', function () {
                var term = this.value.toLowerCase().trim();
                rows.forEach(function (row) {
                    row.style.display = term === '' || row.textContent.toLowerCase().indexOf(term) !== -1 ? '' : 'none';
                });
            });
        })();
    </script>
}
