@model IList<OptimumCoaching.service.InboxItem>
@using OptimumCoaching.web.Models
@{
    ViewData["Title"] = "Messages";
    var unread = (int)(ViewBag.UnreadTotal ?? 0);
}

<div class="content-header row">
    <div class="content-header-left col-md-8 col-12 mb-1">
        <h3 class="content-header-title mb-0">
            <i class="fa fa-envelope mr-1 text-primary"></i> Messages
            @if (unread > 0)
            { <span class="badge badge-pill badge-danger ml-1">@unread new</span> }
        </h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Communication</li>
                    <li class="breadcrumb-item active">Messages</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-4 col-12 mb-1 text-md-right">
        <a class="btn btn-custom btn-medium" asp-action="Compose">
            <i class="fa fa-pencil"></i> New Message
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card">
        <div class="card-body text-center py-4">
            <i class="fa fa-comments-o fa-3x text-muted mb-2"></i>
            <p class="text-muted mb-2">No conversations yet.</p>
            <a class="btn btn-custom" asp-action="Compose">
                <i class="fa fa-pencil mr-1"></i> Start a conversation
            </a>
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <ul class="list-group list-group-flush">
                @foreach (var item in Model)
                {
                    var to = RoleLabels.For(item.TargetRole);
                    <li class="list-group-item @(item.IsUnread ? "oc-msg-row--unread" : "")"
                        style="@(item.IsUnread ? "background:#F5FAFF;border-left:3px solid #5B6FE8;" : "")">
                        <a asp-action="Open" asp-route-id="@item.Id" class="text-decoration-none text-dark d-block">
                            <div class="d-flex justify-content-between align-items-start flex-wrap">
                                <div class="mr-2" style="min-width:0;">
                                    <div class="d-flex align-items-center flex-wrap">
                                        <strong class="mr-2">@item.Subject</strong>
                                        @if (item.IsUnread)
                                        { <span class="badge badge-pill badge-info">New</span> }
                                        @if (item.Status == OptimumCoaching.core.ConversationStatus.Closed)
                                        { <span class="badge badge-pill badge-secondary ml-1">Closed</span> }
                                    </div>
                                    <small class="text-muted d-block">
                                        @if (item.ViewerIsOriginator)
                                        {
                                            <text>To <strong>@to</strong></text>
                                        }
                                        else
                                        {
                                            <text>From <strong>@item.OriginatorName</strong></text>
                                        }
                                        · last by @(item.LastSenderName ?? "—")
                                    </small>
                                    @if (!string.IsNullOrWhiteSpace(item.LastMessageSnippet))
                                    {
                                        <div class="small text-muted mt-1" style="white-space:pre-wrap; overflow:hidden; text-overflow:ellipsis;">
                                            @item.LastMessageSnippet
                                        </div>
                                    }
                                </div>
                                <small class="text-muted text-nowrap mt-1">
                                    @item.LastMessageAt.ToString("dd MMM yyyy, HH:mm")
                                </small>
                            </div>
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
}
