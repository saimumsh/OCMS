@model ComposeMessageViewModel
@using OptimumCoaching.web.Models
@{
    ViewData["Title"] = "New Message";
}

<div class="content-header row">
    <div class="content-header-left col-12 mb-1">
        <h3 class="content-header-title mb-0">New Message</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Messages</a></li>
                    <li class="breadcrumb-item active">Compose</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                <h4 class="card-title mb-0">Send a message</h4>
            </div>
            <form method="post" asp-action="Compose">
                @Html.AntiForgeryToken()
                <div class="card-body">
                    <div asp-validation-summary="All" class="text-danger mb-1"></div>

                    <div class="form-group row">
                        <label asp-for="TargetRole" class="col-sm-3 col-form-label label-control required"></label>
                        <div class="col-sm-9">
                            <select asp-for="TargetRole" class="form-control" asp-items="@Model.RoleOptions"></select>
                            <small class="text-muted">
                                Anyone in the chosen role will see your message and can reply.
                            </small>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Subject" class="col-sm-3 col-form-label label-control required"></label>
                        <div class="col-sm-9">
                            <input asp-for="Subject" class="form-control" placeholder="Brief subject line" autofocus />
                            <span asp-validation-for="Subject" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="form-group row">
                        <label asp-for="Body" class="col-sm-3 col-form-label label-control required"></label>
                        <div class="col-sm-9">
                            <textarea asp-for="Body" class="form-control" rows="6" placeholder="Type your message…"></textarea>
                            <span asp-validation-for="Body" class="text-danger"></span>
                        </div>
                    </div>
                </div>
                <div class="card-footer text-right">
                    <a class="btn btn-custom-default btn-medium mr-1" asp-action="Index">
                        <i class="fa fa-times"></i> Cancel
                    </a>
                    <button type="submit" class="btn btn-custom btn-medium">
                        <i class="fa fa-paper-plane"></i> Send
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
