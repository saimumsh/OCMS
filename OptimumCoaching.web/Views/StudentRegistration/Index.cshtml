@{
    ViewData["Title"] = "Complete your profile";
    Layout = "_Layout";
}

<div class="content-header row">
    <div class="content-header-left col-12 mb-1">
        <h3 class="content-header-title mb-0">Welcome to @OptimumCoaching.web.Program.ProjectName()</h3>
        <p class="text-muted mb-0">Choose how you'd like to use the platform.</p>
    </div>
</div>

<section id="profile-choice">
    <div class="row">
        <div class="col-md-6 mb-3">
            <div class="card profile-choice-card h-100">
                <div class="card-body text-center">
                    <div class="profile-choice-icon bg-gradient-x-primary mb-2">
                        <i class="fa fa-graduation-cap"></i>
                    </div>
                    <h4 class="mb-1">I'm a Student</h4>
                    <p class="text-muted">
                        Register your profile to enroll in coaching programmes.
                        Your registration will be reviewed by an admin before activation.
                    </p>
                    <a class="btn btn-custom btn-medium" asp-action="Register">
                        <i class="fa fa-arrow-right"></i> Register as Student
                    </a>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-3">
            <div class="card profile-choice-card h-100">
                <div class="card-body text-center">
                    <div class="profile-choice-icon bg-gradient-x-warning mb-2">
                        <i class="fa fa-users"></i>
                    </div>
                    <h4 class="mb-1">I'm a Parent / Guardian</h4>
                    <p class="text-muted">
                        Register as a guardian so you can manage your child's coaching journey
                        and stay in touch with their teachers.
                    </p>
                    <a class="btn btn-custom btn-medium" asp-controller="GuardianRegistration" asp-action="Register">
                        <i class="fa fa-arrow-right"></i> Register as Guardian
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
