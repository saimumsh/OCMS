@model StudentRegistrationViewModel
@{
    ViewData["Title"] = "Register as Student";
    Layout = "_Layout";
}

<div class="content-header row">
    <div class="content-header-left col-12 mb-1">
        <h3 class="content-header-title mb-0">Register as Student</h3>
        <p class="text-muted mb-0">Tell us about yourself. An admin will review and approve your registration.</p>
    </div>
</div>

<section id="student-self-register">
    <form method="post" asp-action="Register" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row">
            <div class="col-lg-4 col-md-5 mb-3">
                <div class="card user-photo-card">
                    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                        <h4 class="card-title mb-0">Profile Picture</h4>
                    </div>
                    <div class="card-body text-center">
                        <div class="user-photo-preview mb-2">
                            <img id="studentPhotoPreview" src="~/images/no-image.jpg" alt="profile preview" />
                        </div>
                        <label class="btn btn-custom btn-medium mb-1" for="Image">
                            <i class="fa fa-camera"></i> Choose Photo
                        </label>
                        <input type="file" asp-for="Image" id="Image" accept="image/*"
                               class="d-none" onchange="previewStudentPhoto(this)" />
                        <span asp-validation-for="Image" class="text-danger d-block"></span>
                        <p class="text-muted font-small-3 mt-1 mb-0">
                            JPG, PNG, GIF or WebP &middot; up to 4 MB
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-lg-8 col-md-7 mb-3">
                <div class="card">
                    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                        <h4 class="card-title mb-0">Personal Information</h4>
                    </div>
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-1"></div>

                        <div class="form-group row">
                            <label asp-for="FullName" class="col-sm-3 col-form-label label-control required"></label>
                            <div class="col-sm-9">
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="Email" class="col-sm-3 col-form-label label-control"></label>
                            <div class="col-sm-9">
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="PhoneNumber" class="col-sm-3 col-form-label label-control"></label>
                            <div class="col-sm-9">
                                <input asp-for="PhoneNumber" class="form-control" />
                                <span asp-validation-for="PhoneNumber" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="DateOfBirth" class="col-sm-3 col-form-label label-control"></label>
                            <div class="col-sm-9">
                                <input asp-for="DateOfBirth" class="form-control" type="date" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="Gender" class="col-sm-3 col-form-label label-control"></label>
                            <div class="col-sm-9">
                                <select asp-for="Gender" class="form-control"
                                        asp-items="Html.GetEnumSelectList<Gender>()"></select>
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="Address" class="col-sm-3 col-form-label label-control"></label>
                            <div class="col-sm-9">
                                <textarea asp-for="Address" class="form-control" rows="2"></textarea>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card mt-1">
                    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                        <h4 class="card-title mb-0">Department</h4>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <label asp-for="DepartmentId" class="col-sm-3 col-form-label label-control required">Department</label>
                            <div class="col-sm-9">
                                <select asp-for="DepartmentId" class="form-control">
                                    <option value="">— Select department —</option>
                                    @foreach (var grp in Model.Departments.GroupBy(d => d.Stream).OrderBy(g => g.Key))
                                    {
                                        <optgroup label="@(grp.Key == OptimumCoaching.core.EducationStream.Diploma ? "Diploma" : "Academic")">
                                            @foreach (var d in grp.OrderBy(x => x.Name))
                                            {
                                                <option value="@d.Id" selected="@(Model.DepartmentId == d.Id)">@d.Name</option>
                                            }
                                        </optgroup>
                                    }
                                </select>
                                <span asp-validation-for="DepartmentId" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <partial name="_AcademicRecordsCard" model="Model.AcademicRecords" />

                <div class="card mt-1">
                    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5">
                        <h4 class="card-title mb-0">Parent / Guardian Contact</h4>
                    </div>
                    <div class="card-body">
                        <div class="form-group row">
                            <label asp-for="GuardianName" class="col-sm-3 col-form-label label-control"></label>
                            <div class="col-sm-9">
                                <input asp-for="GuardianName" class="form-control" />
                            </div>
                        </div>

                        <div class="form-group row">
                            <label asp-for="GuardianPhone" class="col-sm-3 col-form-label label-control"></label>
                            <div class="col-sm-9">
                                <input asp-for="GuardianPhone" class="form-control" />
                                <span asp-validation-for="GuardianPhone" class="text-danger"></span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-1">
                    <a class="btn btn-custom-default btn-medium mr-1" asp-action="Index">
                        <i class="fa fa-arrow-left"></i> Back
                    </a>
                    <button type="submit" class="btn btn-custom btn-medium">
                        <i class="fa fa-paper-plane"></i> Submit for Approval
                    </button>
                </div>
            </div>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <datalist id="academicGroupSuggestions">
        <option value="Science"></option>
        <option value="Arts"></option>
        <option value="Commerce"></option>
        <option value="Computer"></option>
        <option value="Electrical"></option>
        <option value="Electronics"></option>
        <option value="Civil"></option>
        <option value="Mechanical"></option>
    </datalist>
    <script>
        function previewStudentPhoto(input) {
            var preview = document.getElementById('studentPhotoPreview');
            if (input && input.files && input.files[0]) {
                var reader = new FileReader();
                reader.onload = function (e) { preview.src = e.target.result; };
                reader.readAsDataURL(input.files[0]);
            }
        }
    </script>
    <partial name="_AcademicRecordsScript" />
}
