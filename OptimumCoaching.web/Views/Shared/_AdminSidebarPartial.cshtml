@model System.Security.Principal.IIdentity
<div class="main-menu menu-fixed menu-dark menu-accordion menu-shadow" data-scroll-to-active="true">
    <div class="main-menu-content">
        <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">
            <li class="nav-item">
                <a href="@Url.Action("Dashboard", "Home", new { area = "" })">
                    <i class="fa fa-home"></i>
                    <span class="menu-title" data-i18n="">Dashboard</span>
                </a>
            </li>

            <li class="nav-item">
                <a href="#"><i class="fa fa-graduation-cap"></i><span class="menu-title" data-i18n="">Coaching</span></a>
                <ul class="menu-content">
                    <li>
                        <a class="menu-item" asp-area="Admin" asp-controller="Teachers" asp-action="Index">Teachers</a>
                    </li>
                    <li>
                        <a class="menu-item" asp-area="Admin" asp-controller="Students" asp-action="Index">Students</a>
                    </li>
                    <li>
                        <a class="menu-item" asp-area="Admin" asp-controller="Students" asp-action="Pending">Pending Approvals</a>
                    </li>
                    <li>
                        <a class="menu-item" asp-area="Admin" asp-controller="Guardians" asp-action="Index">Guardians</a>
                    </li>
                </ul>
            </li>

            <li class="nav-item">
                <a href="#"><i class="fa fa-cogs"></i><span class="menu-title" data-i18n="">Configuration</span></a>
                <ul class="menu-content">
                    <li>
                        <a class="menu-item" asp-area="Admin" asp-controller="Departments" asp-action="Index">Departments</a>
                    </li>
                    <li>
                        <a class="menu-item" asp-area="Admin" asp-controller="Batches" asp-action="Index">Batches</a>
                    </li>
                </ul>
            </li>

            <li class="nav-item">
                <a href="#"><i class="ft-user"></i><span class="menu-title" data-i18n="">User Settings</span></a>
                <ul class="menu-content">
                    <li>
                        <a class="menu-item" asp-area="Admin" asp-controller="Users" asp-action="Index">Users List</a>
                    </li>
                    @if (Model != null && (Model.HasRole(Roles.SuperAdmin) || Model.HasRole(Roles.Dev)))
                    {
                        <li>
                            <a class="menu-item" asp-area="Admin" asp-controller="Roles" asp-action="Index">User Roles</a>
                        </li>
                        <li>
                            <a class="menu-item" asp-area="Admin" asp-controller="Permissions" asp-action="Index">Permissions</a>
                        </li>
                    }
                </ul>
            </li>

            <li class="nav-item">
                <a href="@Url.Action("ChangePassword", "Account", new { area = "Identity" })">
                    <i class="ft-lock"></i>
                    <span class="menu-title" data-i18n="">Change Password</span>
                </a>
            </li>
        </ul>
    </div>
</div>
