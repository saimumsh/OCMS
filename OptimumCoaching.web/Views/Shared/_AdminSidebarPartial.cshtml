@model System.Security.Principal.IIdentity
@inject OptimumCoaching.service.IMessagingService MessagingSvc
@{
    var canSeeTeachers   = Model != null && Model.HasPermission(Permissions.Teachers.ListView);
    var canSeeStudents   = Model != null && Model.HasPermission(Permissions.Students.ListView);
    var canApproveStudents = Model != null && Model.HasPermission(Permissions.Students.Approve);
    var canSeeGuardians  = Model != null && Model.HasPermission(Permissions.Guardians.ListView);
    var canSeeAnyCoaching = canSeeTeachers || canSeeStudents || canSeeGuardians;

    var canSeeDepartments = Model != null && Model.HasPermission(Permissions.Departments.ListView);
    var canSeeSubjects    = Model != null && Model.HasPermission(Permissions.Subjects.ListView);
    var canSeeBatches     = Model != null && Model.HasPermission(Permissions.Batches.ListView);
    var canSeeAnyConfig   = canSeeDepartments || canSeeSubjects || canSeeBatches;

    var canSeeOnlineCourses = Model != null && Model.HasPermission(Permissions.OnlineCourses.ListView);

    var canSeeNotices    = Model != null && Model.HasPermission(Permissions.Notices.ListView);
    var canSeeUsers      = Model != null && Model.HasPermission(Permissions.Users.ListView);
    var canSeeExams      = Model != null && Model.HasPermission(Permissions.Exams.ListView);
    var canSeeReports    = Model != null && Model.HasPermission(Permissions.TeacherReports.ListView);
    var canSeeTopics     = Model != null && Model.HasPermission(Permissions.Topics.ListView);
    var canSeeMaterials  = Model != null && Model.HasPermission(Permissions.Materials.ListView);
    var canSeeRoutine    = Model != null && Model.HasPermission(Permissions.Routine.ListView);
    var canSeeAnyClassroom = canSeeTopics || canSeeMaterials || canSeeRoutine;
    var canSeeFinance    = Model != null && Model.HasPermission(Permissions.Finance.ListView);
    var canSeeSalaries   = Model != null && Model.HasPermission(Permissions.Finance.ViewSalaries);
    var canSeeAnyFinance = canSeeFinance || canSeeSalaries;
    var canSeeAttendance = Model != null && Model.HasPermission(Permissions.Attendance.ListView);
    var isSuperOrDev     = Model != null && (Model.HasRole(Roles.SuperAdmin) || Model.HasRole(Roles.Dev));

    var unreadMessages = 0;
    if (Model != null && Model.IsAuthenticated &&
        Guid.TryParse(Model.Id(), out var msgUid) && msgUid != Guid.Empty)
    {
        unreadMessages = await MessagingSvc.GetUnreadCountAsync(msgUid, Model.GetRoles());
    }
}
<div class="main-menu menu-fixed menu-dark menu-accordion menu-shadow" data-scroll-to-active="true">
    <div class="main-menu-content">
        <ul class="navigation navigation-main" id="main-menu-navigation" data-menu="menu-navigation">
            <li class="nav-item">
                <a href="@Url.Action("Dashboard", "Home", new { area = "" })">
                    <i class="fa fa-home"></i>
                    <span class="menu-title" data-i18n="">Dashboard</span>
                </a>
            </li>

            @if (canSeeAnyCoaching)
            {
                <li class="nav-item">
                    <a href="#"><i class="fa fa-graduation-cap"></i><span class="menu-title" data-i18n="">Coaching</span></a>
                    <ul class="menu-content">
                        @if (canSeeTeachers)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Teachers" asp-action="Index">Teachers</a></li>
                        }
                        @if (canSeeStudents)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Students" asp-action="Index">Students</a></li>
                        }
                        @if (canApproveStudents)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Students" asp-action="Pending">Pending Approvals</a></li>
                        }
                        @if (canSeeGuardians)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Guardians" asp-action="Index">Guardians</a></li>
                        }
                    </ul>
                </li>
            }

            @if (canSeeNotices)
            {
                <li class="nav-item">
                    <a href="#"><i class="fa fa-bullhorn"></i><span class="menu-title" data-i18n="">Notices</span></a>
                    <ul class="menu-content">
                        <li><a class="menu-item" asp-area="" asp-controller="Notices" asp-action="Index">All Notices</a></li>
                        <li><a class="menu-item" asp-area="Admin" asp-controller="NoticeConfig" asp-action="Index">Notice Settings</a></li>
                        <li><a class="menu-item" asp-area="Admin" asp-controller="NoticeConfig" asp-action="Templates">Templates</a></li>
                    </ul>
                </li>
            }

            @if (canSeeExams)
            {
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="Exams" asp-action="Index">
                        <i class="fa fa-pencil-square-o"></i><span class="menu-title" data-i18n="">Exams</span>
                    </a>
                </li>
            }

            @if (canSeeOnlineCourses)
            {
                <li class="nav-item">
                    <a href="#"><i class="fa fa-video-camera"></i><span class="menu-title" data-i18n="">Online Courses</span></a>
                    <ul class="menu-content">
                        <li><a class="menu-item" asp-area="Admin" asp-controller="OnlineCourses" asp-action="Index">All Online Courses</a></li>
                        @if (Model != null && Model.HasPermission(Permissions.OnlineCourses.AddEdit))
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="OnlineCourses" asp-action="Create">New Online Course</a></li> }
                        <li><a class="menu-item" asp-area="" asp-controller="Courses" asp-action="Index">Public Catalog</a></li>
                    </ul>
                </li>
            }

            @if (canSeeAnyClassroom)
            {
                <li class="nav-item">
                    <a href="#"><i class="fa fa-book"></i><span class="menu-title" data-i18n="">Classroom</span></a>
                    <ul class="menu-content">
                        @if (canSeeTopics)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Topics" asp-action="Index">Topics</a></li> }
                        @if (canSeeMaterials)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Materials" asp-action="Index">Materials</a></li> }
                        @if (canSeeRoutine)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Routine" asp-action="Index">Routine</a></li> }
                        @if (Model != null && Model.HasPermission(Permissions.Lessons.ListView))
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Lessons" asp-action="Index">Online Lessons</a></li> }
                        @if (Model != null && Model.HasPermission(Permissions.Assignments.ListView))
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Assignments" asp-action="Index">Assignments</a></li> }
                        @if (canSeeAttendance)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Attendance" asp-action="Index">Attendance</a></li> }
                    </ul>
                </li>
            }

            @if (canSeeAnyFinance)
            {
                <li class="nav-item">
                    <a href="#"><i class="fa fa-money"></i><span class="menu-title" data-i18n="">Finance</span></a>
                    <ul class="menu-content">
                        @if (canSeeFinance)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Finance" asp-action="Index">Overview</a></li> }
                        @if (canSeeFinance)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Finance" asp-action="Students">Fees by Student</a></li> }
                        @if (canSeeFinance)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Finance" asp-action="StudentFees">Fees by Batch</a></li> }
                        @if (canSeeSalaries)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Finance" asp-action="Salaries">Teacher Salaries</a></li> }
                        @if (canSeeFinance)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Finance" asp-action="Dues">Overdue / Dues</a></li> }
                        @if (canSeeFinance)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="Finance" asp-action="PendingRequests">Pending Payments</a></li> }
                        @if (canSeeFinance)
                        { <li><a class="menu-item" asp-area="Admin" asp-controller="PaymentConfig" asp-action="Index">Payment Settings</a></li> }
                    </ul>
                </li>
            }

            @if (canSeeReports)
            {
                <li class="nav-item">
                    <a asp-area="Admin" asp-controller="TeacherReports" asp-action="Index">
                        <i class="fa fa-flag"></i><span class="menu-title" data-i18n="">Teacher Reports</span>
                    </a>
                </li>
            }

            <li class="nav-item">
                <a asp-area="" asp-controller="Messages" asp-action="Index">
                    <i class="fa fa-envelope"></i><span class="menu-title" data-i18n="">Messages</span>
                    @if (unreadMessages > 0)
                    { <span class="badge badge-pill badge-danger float-right">@unreadMessages</span> }
                </a>
            </li>

            @if (canSeeAnyConfig)
            {
                <li class="nav-item">
                    <a href="#"><i class="fa fa-cogs"></i><span class="menu-title" data-i18n="">Configuration</span></a>
                    <ul class="menu-content">
                        @if (canSeeDepartments)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Departments" asp-action="Index">Departments</a></li>
                        }
                        @if (canSeeSubjects)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Subjects" asp-action="Index">Subjects</a></li>
                        }
                        @if (canSeeBatches)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Batches" asp-action="Index">Batches</a></li>
                        }
                    </ul>
                </li>
            }

            @if (canSeeUsers || isSuperOrDev)
            {
                <li class="nav-item">
                    <a href="#"><i class="ft-user"></i><span class="menu-title" data-i18n="">User Settings</span></a>
                    <ul class="menu-content">
                        @if (canSeeUsers)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Users" asp-action="Index">Users List</a></li>
                        }
                        @if (isSuperOrDev)
                        {
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Roles" asp-action="Index">User Roles</a></li>
                            <li><a class="menu-item" asp-area="Admin" asp-controller="Permissions" asp-action="Index">Permissions</a></li>
                        }
                    </ul>
                </li>
            }

            <li class="nav-item">
                <a href="@Url.Action("ChangePassword", "Account", new { area = "Identity" })">
                    <i class="ft-lock"></i>
                    <span class="menu-title" data-i18n="">Change Password</span>
                </a>
            </li>
        </ul>
    </div>
</div>
