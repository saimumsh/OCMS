@{
    Layout = "_Layout";
    ViewData["UseDashboardLayout"] = true;
}

<div class="dashboard-shell" id="dashboardShell">
    @await Html.PartialAsync("_DashboardSidebar")

    <div class="dashboard-content">
        @RenderBody()
    </div>
</div>

@section Scripts {
    @await RenderSectionAsync("Scripts", required: false)
}
