@using OptimumCoaching.core

@if (User.Identity?.IsAuthenticated == true)
{
    var isAdminArea = User.IsInRole(Roles.Admin) || User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.Dev);

    <aside id="dashboardSidebar" class="dashboard-sidebar">
        <div class="dashboard-sidebar-header">
            <span class="dashboard-sidebar-title">Dashboard</span>
            <button type="button" class="dashboard-sidebar-toggle" id="dashboardSidebarToggle"
                    aria-label="Toggle sidebar" aria-expanded="true" aria-controls="dashboardSidebar">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                    <path fill-rule="evenodd" d="M11.354 1.646a.5.5 0 0 1 0 .708L5.707 8l5.647 5.646a.5.5 0 0 1-.708.708l-6-6a.5.5 0 0 1 0-.708l6-6a.5.5 0 0 1 .708 0z"/>
                </svg>
            </button>
        </div>

        <nav class="dashboard-sidebar-nav">
            <ul>
                <li>
                    <a asp-area="" asp-controller="Home" asp-action="Dashboard" title="Overview">
                        <span class="dashboard-sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M6.5 14.5v-3.505c0-.245.25-.495.5-.495h2c.25 0 .5.25.5.5v3.5a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5v-7a.5.5 0 0 0-.146-.354L13 5.793V2.5a.5.5 0 0 0-.5-.5h-1a.5.5 0 0 0-.5.5v1.293L8.354 1.146a.5.5 0 0 0-.708 0l-6 6A.5.5 0 0 0 1.5 7.5v7a.5.5 0 0 0 .5.5h4a.5.5 0 0 0 .5-.5z"/>
                            </svg>
                        </span>
                        <span class="dashboard-sidebar-label">Overview</span>
                    </a>
                </li>

                @if (isAdminArea)
                {
                    <li class="dashboard-sidebar-section">
                        <span class="dashboard-sidebar-label">Administration</span>
                    </li>
                    <li>
                        <a asp-area="Admin" asp-controller="Users" asp-action="Index" title="Users">
                            <span class="dashboard-sidebar-icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                                    <path d="M15 14s1 0 1-1-1-4-5-4-5 3-5 4 1 1 1 1zm-7.978-1A.261.261 0 0 1 7 12.996c.001-.264.167-1.03.76-1.72C8.312 10.629 9.282 10 11 10c1.717 0 2.687.63 3.24 1.276.593.69.758 1.457.76 1.72l-.008.002a.274.274 0 0 1-.014.002zM11 7a2 2 0 1 0 0-4 2 2 0 0 0 0 4m3-2a3 3 0 1 1-6 0 3 3 0 0 1 6 0M6.936 9.28a5.88 5.88 0 0 0-1.23-.247A7 7 0 0 0 5 9c-4 0-5 3-5 4 0 .667.333 1 1 1h4.216A2.24 2.24 0 0 1 5 13c0-1.01.377-2.042 1.09-2.904.243-.294.526-.569.846-.816M4.92 10A5.5 5.5 0 0 0 4 13H1c0-.26.164-1.03.76-1.724.545-.636 1.492-1.256 3.16-1.275ZM1.5 5.5a3 3 0 1 1 6 0 3 3 0 0 1-6 0m3-2a2 2 0 1 0 0 4 2 2 0 0 0 0-4"/>
                                </svg>
                            </span>
                            <span class="dashboard-sidebar-label">Users</span>
                        </a>
                    </li>
                    @if (User.IsInRole(Roles.SuperAdmin) || User.IsInRole(Roles.Dev))
                    {
                        <li>
                            <a asp-area="Admin" asp-controller="Roles" asp-action="Index" title="Roles">
                                <span class="dashboard-sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M5.072.56C6.157.265 7.31 0 8 0s1.843.265 2.928.56c1.11.3 2.229.655 2.887.87a1.54 1.54 0 0 1 1.044 1.262c.596 4.477-.787 7.795-2.465 9.99a11.8 11.8 0 0 1-2.517 2.453 7 7 0 0 1-1.048.625c-.28.132-.581.24-.829.24s-.548-.108-.829-.24a7 7 0 0 1-1.048-.625 11.8 11.8 0 0 1-2.517-2.453C1.928 10.487.545 7.169 1.141 2.692A1.54 1.54 0 0 1 2.185 1.43 63 63 0 0 1 5.072.56"/>
                                    </svg>
                                </span>
                                <span class="dashboard-sidebar-label">Roles</span>
                            </a>
                        </li>
                        <li>
                            <a asp-area="Admin" asp-controller="Permissions" asp-action="Index" title="Permissions">
                                <span class="dashboard-sidebar-icon">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                                        <path d="M0 4a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H2a2 2 0 0 1-2-2zm9.5 5.5a1.5 1.5 0 1 0-2-2.122V11.5a.5.5 0 0 0 1 0V9.5h-1z"/>
                                        <path d="M7 5.5V3.5A3.5 3.5 0 1 1 14 3.5v2h-1v-2a2.5 2.5 0 0 0-5 0v2z"/>
                                    </svg>
                                </span>
                                <span class="dashboard-sidebar-label">Permissions</span>
                            </a>
                        </li>
                    }
                }

                <li class="dashboard-sidebar-section">
                    <span class="dashboard-sidebar-label">Account</span>
                </li>
                <li>
                    <a asp-area="Identity" asp-page="/Account/ChangePassword" title="Change password">
                        <span class="dashboard-sidebar-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 16 16" fill="currentColor">
                                <path d="M8 1a2 2 0 0 1 2 2v4H6V3a2 2 0 0 1 2-2m3 6V3a3 3 0 0 0-6 0v4a2 2 0 0 0-2 2v5a2 2 0 0 0 2 2h6a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2"/>
                            </svg>
                        </span>
                        <span class="dashboard-sidebar-label">Change password</span>
                    </a>
                </li>
            </ul>
        </nav>
    </aside>
}
