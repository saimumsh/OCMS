@{
    var currentUser = User.Identity;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    @* <title>@ViewData["Title"] - @OptimumCoaching.web.Program.ProjectName()</title>
 *@
    <link rel="icon" type="image/png" sizes="16x16" href="~/favicon.ico">

    <!-- Font styles -->
    <link href="~/themeCSS/fonts/feather/style.min.css" rel="stylesheet" />
    <link href="~/themeCSS/fonts/flag-icon-css/css/flag-icon.min.css" rel="stylesheet" />
    <link href="~/themeCSS/fonts/font-awesome/css/font-awesome.min.css" rel="stylesheet" />
    <link href="~/themeCSS/fonts/meteocons/style.min.css" rel="stylesheet" />
    <link href="~/themeCSS/fonts/simple-line-icons/style.min.css" rel="stylesheet" />
    <!-- /font styles -->
    <!-- Theme Styles -->
    <link href="~/themeCSS/style.css" rel="stylesheet" />
    <link href="~/themeCSS/css/colors.min.css" rel="stylesheet">
    <link href="~/themeCSS/css/components.min.css" rel="stylesheet">
    <link href="~/themeCSS/css/vendors.min.css" rel="stylesheet" />
    <link href="~/themeCSS/css/core/menu/menu-types/vertical-menu-modern.css" rel="stylesheet" />
    <link href="~/themeCSS/css/core/colors/palette-gradient.min.css" rel="stylesheet" />
    <link href="~/themeCSS/css/pages/timeline.min.css" rel="stylesheet" />
    <link href="~/themeCSS/css/app.min.css" rel="stylesheet" />
    <link href="~/themeCSS/vendors/css/forms/selects/select2.css" rel="stylesheet" />
    <!-- /theme Styles -->
    <!-- Chart style -->
    <link href="~/themeCSS/css/pages/card-statistics.min.css" rel="stylesheet">
    <link href="~/themeCSS/css/pages/vertical-timeline.min.css" rel="stylesheet">
    <!-- /chart style -->

    <link href="~/css/bootstrap-datepicker.min.css" rel="stylesheet" />

    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="vertical-layout vertical-menu-modern 2-columns menu-expanded fixed-navbar"
      data-open="click" data-menu="vertical-menu-modern" data-col="2-columns">
    <!-- Header partial -->
    <partial name="_HeaderPartial" model="currentUser" />
    <!-- /header partial -->
    <!-- Sidebar partial -->
    <partial name="_AdminSidebarPartial" model="currentUser" />
    <!-- /sidebar partial -->

    <div class="app-content content">
        <div class="content-wrapper">
            <div class="content-body">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Footer partial -->
    <partial name="_FooterPartial" />
    <!-- /footer partial -->

    <!-- Core JS files -->
    <script src="~/js/jquery-3.6.0.min.js"></script>
    <!-- /core JS files -->
    <!-- Theme JS files -->
    <script src="~/themeJS/vendors/js/vendors.min.js"></script>
    <script src="~/themeJS/vendors/js/extensions/unslider-min.js"></script>
    <script src="~/themeJS/vendors/js/timeline/horizontal-timeline.js"></script>
    <script src="~/themeJS/js/core/app-menu.js"></script>
    <script src="~/themeJS/js/core/app.js"></script>
    <script src="~/themeJS/js/scripts/customizer.js"></script>
    <script src="~/themeJS/vendors/js/forms/select/select2.js"></script>
    <!-- /theme JS files -->

    <script src="~/js/bootstrap-datepicker.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <!-- OCMS sidebar shell: state, responsive, backdrop, scroll-lock -->
    <script type="text/javascript">
        $(function ($) {
            var $body = $('body');
            var STORE_KEY = 'oc.menuCollapsed';
            var MOBILE_Q = '(max-width: 767.98px)';
            var isSmall = function () { return window.matchMedia(MOBILE_Q).matches; };

            var url = window.location.href;
            $('li a').each(function () {
                if (this.href === url) $(this).closest('li').addClass('active');
            });

            $('.main-menu .navigation > li > a').each(function () {
                var $a = $(this);
                var label = $.trim($a.find('.menu-title').first().text());
                if (label) $a.attr('data-title', label);
            });

            var ensureBackdrop = function () {
                var $bd = $('.oc-sidebar-backdrop');
                if (!$bd.length) {
                    $bd = $('<div class="oc-sidebar-backdrop" aria-hidden="true"></div>').appendTo('body');
                    $bd.on('click', function () { collapseMenu(true); });
                }
                return $bd;
            };

            var setToggleIcon = function (collapsed) {
                var $icon = $('.modern-nav-toggle .toggle-icon');
                if (collapsed) $icon.removeClass('ft-toggle-right').addClass('ft-toggle-left');
                else           $icon.removeClass('ft-toggle-left').addClass('ft-toggle-right');
            };

            var expandMenu = function (persist) {
                $body.removeClass('menu-collapsed menu-hide').addClass('menu-expanded');
                setToggleIcon(false);
                if (isSmall()) {
                    $body.addClass('oc-menu-overlay-open');
                    ensureBackdrop().addClass('is-visible');
                }
                if (persist !== false) {
                    try { localStorage.setItem(STORE_KEY, '0'); } catch (e) { /* ignore */ }
                }
            };

            var collapseMenu = function (persist) {
                $body.removeClass('menu-expanded menu-open oc-menu-overlay-open').addClass('menu-collapsed');
                setToggleIcon(true);
                $('.oc-sidebar-backdrop').removeClass('is-visible');
                if (persist !== false) {
                    try { localStorage.setItem(STORE_KEY, '1'); } catch (e) { /* ignore */ }
                }
            };

            try {
                var stored = localStorage.getItem(STORE_KEY);
                var shouldCollapse = stored === '1' || (stored === null && isSmall());
                if (shouldCollapse) collapseMenu(false);
            } catch (e) { /* ignore */ }

            $(document).on('click', '.modern-nav-toggle, .menu-toggle', function (e) {
                e.preventDefault();
                if ($body.hasClass('menu-expanded') || $body.hasClass('menu-open')) {
                    collapseMenu(true);
                } else {
                    expandMenu(true);
                }
            });

            $(document).on('click', '.main-menu .navigation a', function () {
                if (!isSmall() || !$body.hasClass('menu-expanded')) return;
                var $a = $(this);
                var href = $a.attr('href');
                var $li = $a.parent('li');
                if (!$li.hasClass('has-sub') && href && href !== '#') {
                    collapseMenu(true);
                }
            });

            var lastSmall = isSmall();
            $(window).on('resize', function () {
                var nowSmall = isSmall();
                if (nowSmall === lastSmall) return;
                lastSmall = nowSmall;
                if (nowSmall) {
                    if ($body.hasClass('menu-expanded')) {
                        $body.addClass('oc-menu-overlay-open');
                        ensureBackdrop().addClass('is-visible');
                    }
                } else {
                    $body.removeClass('oc-menu-overlay-open');
                    $('.oc-sidebar-backdrop').removeClass('is-visible');
                }
            });
        });
    </script>
</body>
</html>
