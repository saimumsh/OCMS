@model NoticeFormViewModel
@{
    ViewData["Title"] = "Edit Notice";
}

<div class="content-header row">
    <div class="content-header-left col-md-9 col-12 mb-1">
        <h3 class="content-header-title mb-0">Edit Notice</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a asp-action="Index">Notices</a></li>
                    <li class="breadcrumb-item active">@Model.Title</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<section id="notice-edit">
    <form method="post" asp-action="Edit">
        @Html.AntiForgeryToken()
        <partial name="_NoticeForm" model="Model" />
    </form>
</section>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
