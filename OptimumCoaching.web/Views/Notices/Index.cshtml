@using OptimumCoaching.web.Models
@using OptimumCoaching.web.Models.IdentityModels
@model IList<NoticeListItem>
@{
    ViewData["Title"] = "Notices";
    var activeAudience = ViewBag.ActiveAudience as NoticeAudience?;
    var canAdd = User.Identity != null && User.Identity.HasPermission(OptimumCoaching.core.Permissions.Notices.AddEdit);
    var canDelete = User.Identity != null && User.Identity.HasPermission(OptimumCoaching.core.Permissions.Notices.Delete);
}

<div class="content-header row">
    <div class="content-header-left col-md-7 col-12 mb-1">
        <h3 class="content-header-title mb-0">Notices</h3>
        <div class="row breadcrumbs-top">
            <div class="breadcrumb-wrapper col-12">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item">Communications</li>
                    <li class="breadcrumb-item active">Notices</li>
                </ol>
            </div>
        </div>
    </div>
    <div class="content-header-right col-md-5 col-12 mb-1 text-md-right">
        <div class="btn-group mr-1" role="group">
            <a class="btn btn-sm @(activeAudience == null ? "btn-custom" : "btn-custom-default")" asp-action="Index">All</a>
            <a class="btn btn-sm @(activeAudience == NoticeAudience.Students ? "btn-custom" : "btn-custom-default")"
               asp-action="Index" asp-route-audience="@NoticeAudience.Students">Students</a>
            <a class="btn btn-sm @(activeAudience == NoticeAudience.Teachers ? "btn-custom" : "btn-custom-default")"
               asp-action="Index" asp-route-audience="@NoticeAudience.Teachers">Teachers</a>
        </div>
        @if (canAdd)
        {
            <a class="btn btn-custom btn-medium" asp-action="Create">
                <i class="fa fa-plus"></i> New Notice
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @TempData["SuccessMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @TempData["ErrorMessage"]
        <button type="button" class="close" data-dismiss="alert"><span>&times;</span></button>
    </div>
}

@if (!Model.Any())
{
    <div class="card"><div class="card-body text-center py-3"><p class="text-muted mb-0">No notices yet.</p></div></div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-condensed mb-0 user-table">
                    <thead>
                        <tr>
                            <th class="serial">#</th>
                            <th>Title</th>
                            <th>Audience</th>
                            <th>Department</th>
                            <th>Posted</th>
                            <th>Expires</th>
                            <th class="text-center">Status</th>
                            <th class="text-right">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var sn = 0; }
                        @foreach (var n in Model)
                        {
                            sn++;
                            <tr class="@(n.IsExpired ? "text-muted" : "")">
                                <td class="align-middle">@sn</td>
                                <td class="align-middle">
                                    @if (n.IsPinned)
                                    { <i class="fa fa-thumb-tack text-warning mr-1" title="Pinned"></i> }
                                    <strong>@n.Title</strong>
                                    <div class="small text-muted text-truncate" style="max-width: 360px;">@n.Body</div>
                                </td>
                                <td class="align-middle">
                                    @switch (n.Audience)
                                    {
                                        case NoticeAudience.Students:
                                            <span class="badge badge-pill badge-info">Students</span>
                                            break;
                                        case NoticeAudience.Teachers:
                                            <span class="badge badge-pill badge-primary">Teachers</span>
                                            break;
                                        default:
                                            <span class="badge badge-pill badge-success">Both</span>
                                            break;
                                    }
                                </td>
                                <td class="align-middle">@(n.DepartmentName ?? "All")</td>
                                <td class="align-middle">
                                    <small>@n.PostedAt.ToString("dd MMM yyyy, HH:mm")</small>
                                    @if (!string.IsNullOrEmpty(n.PostedByName))
                                    { <div class="small text-muted">by @n.PostedByName</div> }
                                </td>
                                <td class="align-middle">
                                    <small>@(n.ExpiresAt?.ToString("dd MMM yyyy") ?? "—")</small>
                                </td>
                                <td class="align-middle text-center">
                                    @if (n.IsExpired)
                                    { <span class="badge badge-pill badge-secondary">Expired</span> }
                                    else if (n.IsActive)
                                    { <span class="badge badge-pill badge-success">Active</span> }
                                    else
                                    { <span class="badge badge-pill badge-secondary">Inactive</span> }
                                </td>
                                <td class="align-middle text-right action-cell">
                                    @if (canAdd)
                                    {
                                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@n.Id" title="Edit">
                                            <i class="fa fa-pencil"></i>
                                        </a>
                                    }
                                    @if (canDelete)
                                    {
                                        <form method="post" asp-action="Delete" asp-route-id="@n.Id" class="d-inline"
                                              onsubmit="return confirm('Remove this notice?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove">
                                                <i class="fa fa-trash"></i>
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}
