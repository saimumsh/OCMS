@using OptimumCoaching.web.Models.IdentityModels
@model IList<OptimumCoaching.core.Notice>

<div class="card mt-1">
    <div class="card-header border-bottom-blue-grey border-bottom-lighten-5 d-flex justify-content-between align-items-center">
        <h4 class="card-title mb-0">
            <i class="fa fa-bullhorn mr-1 text-warning"></i> Notices
            <span class="badge badge-pill badge-secondary ml-1">@Model.Count</span>
        </h4>
        @if (User.Identity != null && User.Identity.HasPermission(OptimumCoaching.core.Permissions.Notices.AddEdit))
        {
            <a class="btn btn-sm btn-outline-primary" asp-controller="Notices" asp-action="Create">
                <i class="fa fa-plus"></i> Post
            </a>
        }
    </div>
    <div class="card-body">
        @if (!Model.Any())
        {
            <p class="text-muted mb-0">No notices right now.</p>
        }
        else
        {
            <ul class="list-unstyled mb-0">
                @foreach (var n in Model)
                {
                    <li class="batch-update-item"
                        style="@(n.IsPinned ? "border-left: 3px solid #ffb822; padding-left: 10px;" : "")">
                        <div class="d-flex justify-content-between align-items-start">
                            <strong>
                                @if (n.IsPinned)
                                { <i class="fa fa-thumb-tack text-warning mr-1" title="Pinned"></i> }
                                @n.Title
                            </strong>
                            @if (n.Department != null)
                            { <span class="badge badge-light ml-2">@n.Department.Name</span> }
                        </div>
                        <small class="text-muted d-block">
                            @n.PostedAt.ToString("dd MMM yyyy, HH:mm") &middot;
                            @(n.PostedByUser?.FullName ?? "Coaching Centre")
                            @if (n.ExpiresAt.HasValue)
                            { <text>&middot; valid until @n.ExpiresAt.Value.ToString("dd MMM yyyy")</text> }
                        </small>
                        <div class="mt-1" style="white-space: pre-wrap">@n.Body</div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
